.message-editor{
  display:grid;
  gap:1rem;
}

.message-editor input,
.message-editor textarea{
  width:100%;
  box-sizing:border-box;
}

.message-editor textarea{
  min-height:210px;
  resize:vertical;
  line-height:1.55;
}

.message-editor-actions{
  display:flex;
  flex-wrap:wrap;
  gap:.75rem;
  align-items:center;
}

.message-paste-hint{
  color:var(--muted,#9fb0c6);
  font-size:.84rem;
}

.message-image-preview{
  max-width:300px;
  max-height:200px;
  border-radius:12px;
  object-fit:contain;
  border:1px solid rgba(255,255,255,.1);
}

.message-list{
  display:grid;
  gap:.7rem;
}

/* slim always-open moon attempt cards */
.moon-card-slim{
  position:relative;
  overflow:hidden;
  padding:0;
  border:1px solid rgba(96,175,255,.15);
  border-radius:12px;
  background:linear-gradient(145deg,rgba(12,28,46,.95),rgba(7,18,31,.96));
  box-shadow:0 10px 28px rgba(0,0,0,.12);
}

.moon-card-slim::before{
  content:"";
  position:absolute;
  inset:0 auto 0 0;
  width:3px;
  background:linear-gradient(#6fb9ff,#8c7cff);
}

.moon-slim-head{
  min-height:62px;
  padding:.72rem .8rem .62rem 1.35rem;
  display:grid;
  grid-template-columns:58px minmax(0,1fr) auto;
  gap:.8rem;
  align-items:center;
}

.moon-entry-number{
  display:inline-grid;
  place-items:center;
  min-height:32px;
  padding:0 .48rem;
  border-radius:9px;
  border:1px solid rgba(111,185,255,.17);
  background:rgba(92,166,255,.08);
  color:#82c5ff;
  font-size:.8rem;
  font-weight:800;
}

.moon-slim-main{
  min-width:0;
  display:grid;
  gap:.38rem;
}

.moon-slim-title-row{
  min-width:0;
  display:flex;
  align-items:baseline;
  gap:.7rem;
  flex-wrap:wrap;
}

.moon-slim-title-row > strong{
  font-size:.94rem;
}

.moon-slim-date{
  color:#71899f;
  font-size:.72rem;
}

.moon-slim-meta{
  display:flex;
  align-items:center;
  gap:1.25rem;
  flex-wrap:wrap;
  min-width:0;
  color:#aebfce;
  font-size:.76rem;
}

.moon-slim-meta span{
  min-width:0;
}

.moon-slim-meta b{
  color:#7890a7;
  font-weight:600;
}

.moon-slim-actions{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:.35rem;
}

.moon-icon-button{
  width:31px;
  height:31px;
  padding:0;
  display:grid;
  place-items:center;
  border-radius:8px;
  border:1px solid rgba(111,185,255,.18);
  background:rgba(92,166,255,.07);
  color:#8bc8ff;
  cursor:pointer;
}

.moon-icon-button:hover{
  background:rgba(92,166,255,.14);
  border-color:rgba(111,185,255,.32);
  color:#d9efff;
}

.moon-icon-button svg{
  width:15px;
  height:15px;
  fill:none;
  stroke:currentColor;
  stroke-width:1.8;
  stroke-linecap:round;
  stroke-linejoin:round;
}

.moon-icon-danger{
  color:#e89aa5;
  border-color:rgba(222,105,120,.15);
  background:rgba(222,105,120,.055);
}

.moon-icon-danger:hover{
  color:#ffd6dc;
  border-color:rgba(222,105,120,.3);
  background:rgba(222,105,120,.11);
}

.moon-slim-info{
  margin-left:1.35rem;
  padding:.62rem .85rem .66rem .15rem;
  border-top:1px solid rgba(126,181,232,.08);
}

.moon-slim-info-label{
  display:block;
  margin-bottom:.28rem;
  color:#7fa1bf;
  font-size:.68rem;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.09em;
}

.moon-slim-info p{
  margin:0;
  color:#c1d0dd;
  font-size:.82rem;
  line-height:1.42;
  white-space:pre-wrap;
  overflow-wrap:anywhere;
}

.moon-slim-footer{
  padding:.45rem .85rem .55rem 1.35rem;
  color:var(--muted,#9fb0c6);
  font-size:.69rem;
  border-top:1px solid rgba(126,181,232,.05);
  background:rgba(0,0,0,.06);
}

.message-empty{
  text-align:center;
  padding:2rem;
}

.image-modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.88);
  z-index:1000;
  display:grid;
  place-items:center;
  padding:1rem;
}

.image-modal[hidden]{
  display:none;
}

.image-modal img{
  max-width:96vw;
  max-height:92vh;
  object-fit:contain;
}

.image-modal button{
  position:absolute;
  top:1rem;
  right:1rem;
}

@media(max-width:800px){
  .moon-slim-head{
    grid-template-columns:50px minmax(0,1fr) auto;
    gap:.55rem;
    padding-left:1.15rem;
  }

  .moon-slim-meta{
    gap:.45rem .9rem;
  }

  .moon-slim-info{
    margin-left:1.15rem;
  }

  .moon-slim-footer{
    padding-left:1.15rem;
  }
}

@media(max-width:560px){
  .moon-slim-head{
    grid-template-columns:44px minmax(0,1fr);
    grid-template-areas:
      "number main"
      "actions actions";
    row-gap:.5rem;
  }

  .moon-entry-number{grid-area:number}
  .moon-slim-main{grid-area:main}
  .moon-slim-actions{
    grid-area:actions;
    justify-content:flex-end;
  }

  .moon-slim-meta{
    display:grid;
    gap:.2rem;
  }

  .moon-slim-info p{
    font-size:.79rem;
  }

  .message-editor textarea{
    min-height:170px;
  }
}

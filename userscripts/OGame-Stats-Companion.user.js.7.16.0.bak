    {id:"small_shield",cat:"defense",name:"Kleine Schildkuppel",icon:"🛡️",kind:"count",cost:[10000,10000,0]},
    {id:"large_shield",cat:"defense",name:"Große Schildkuppel",icon:"🛡️",kind:"count",cost:[50000,50000,0]},
    {id:"anti_ballistic",cat:"defense",name:"Abfangrakete",icon:"↗️",kind:"count",cost:[8000,0,2000]},
    {id:"interplanetary",cat:"defense",name:"Interplanetarrakete",icon:"☢️",kind:"count",cost:[12500,2500,10000]}
  ];

  function resourceCalcUid() { return `${Date.now().toString(36)}-${Math.random().toString(36).slice(2,8)}`; }
  function resourceCalcLoad() {
    try {
      const parsed = JSON.parse(localStorage.getItem(RESOURCE_CALC_STORAGE_KEY) || "[]");
      return Array.isArray(parsed) ? parsed.map(row => ({ uid: row.uid || resourceCalcUid(), id: row.id, input: String(row.input ?? "") })) : [];
    } catch (_) { return []; }
  }
  function resourceCalcSave(rows) { localStorage.setItem(RESOURCE_CALC_STORAGE_KEY, JSON.stringify(rows)); }
  function resourceCalcEsc(value) { return String(value ?? "").replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function resourceCalcFull(value) { return Math.max(0, Math.round(Number(value)||0)).toLocaleString("de-DE"); }
  function resourceCalcCompact(value) {
    const n=Math.max(0,Number(value)||0), units=[[1e12,"Bio."],[1e9,"Mrd."],[1e6,"M"],[1e3,"k"]];
    for (const [div,suffix] of units) if(n>=div){ const v=n/div; const d=v>=100?0:v>=10?1:2; return v.toLocaleString("de-DE",{maximumFractionDigits:d})+suffix; }
    return Math.round(n).toLocaleString("de-DE");
  }
  function resourceCalcParseNumber(raw) {
    const value=String(raw||"").trim().replace(/\./g,"").replace(",",".");
    if(!/^\d+(?:\.\d+)?$/.test(value)) return 0;
    return Math.max(0,Math.floor(Number(value)||0));
  }
  function resourceCalcCost(item,input) {
    if(!item) return {cost:[0,0,0],label:"",valid:false};
    const value=resourceCalcParseNumber(input);
    if(item.kind==="count") return {cost:item.cost.map(v=>v*value),label:`× ${resourceCalcFull(value)}`,valid:value>0};
    const level=value;
    if(level<1 || level>1000) return {cost:[0,0,0],label:String(input||""),valid:false};
    return {cost:item.base.map(base=>Math.floor(base*Math.pow(item.factor,level-1))),label:`Stufe ${level}`,valid:true};
  }
  function resourceCalcTotals(rows=resourceCalcLoad()) {
    const total=[0,0,0];
    for(const row of rows){ const item=RESOURCE_CALC_ITEMS.find(x=>x.id===row.id); const result=resourceCalcCost(item,row.input); result.cost.forEach((v,i)=>total[i]+=v); }
    return total;
  }
  function resourceCalcAdd(id) {
    const input=document.querySelector(`[data-rc-input="${id}"]`), value=String(input?.value||"").trim();
    const item=RESOURCE_CALC_ITEMS.find(x=>x.id===id), result=resourceCalcCost(item,value);
    if(!item||!result.valid){ showMessage(item?.kind==="level"?"Bitte eine einzelne Stufe größer 0 eingeben.":"Bitte eine Stückzahl größer 0 eingeben.","error"); return; }
    const rows=resourceCalcLoad(); rows.push({uid:resourceCalcUid(),id,input:value}); resourceCalcSave(rows); if(input)input.value=""; resourceCalcRender();
  }
  function resourceCalcRemove(uid){ resourceCalcSave(resourceCalcLoad().filter(x=>x.uid!==uid)); resourceCalcRender(); }
  function resourceCalcUpdate(uid,value){ const rows=resourceCalcLoad(); const row=rows.find(x=>x.uid===uid); if(row){row.input=value;resourceCalcSave(rows);resourceCalcRender();} }
  function resourceCalcClear(){ resourceCalcSave([]); resourceCalcRender(); }
  function resourceCalcCopy(){
    const rows=resourceCalcLoad(), totals=resourceCalcTotals(rows);
    const lines=["Ressourcenrechner",...rows.map(row=>{const item=RESOURCE_CALC_ITEMS.find(x=>x.id===row.id),r=resourceCalcCost(item,row.input);return `${item.name} ${r.label}: ${resourceCalcCompact(r.cost[0])} M | ${resourceCalcCompact(r.cost[1])} K | ${resourceCalcCompact(r.cost[2])} D`;}),"",`Metall: ${resourceCalcFull(totals[0])}`,`Kristall: ${resourceCalcFull(totals[1])}`,`Deuterium: ${resourceCalcFull(totals[2])}`];
    try{GM_setClipboard(lines.join("\n"),"text");}catch(_){navigator.clipboard?.writeText(lines.join("\n"));} showMessage("Ressourcenrechnung kopiert.","success");
  }
  function resourceCalcRenderSummary(){ const t=resourceCalcTotals(); [["metal",t[0]],["crystal",t[1]],["deut",t[2]],["all",t[0]+t[1]+t[2]]].forEach(([k,v])=>{const e=document.querySelector(`#oas-rc-${k}`);if(e){e.textContent=resourceCalcCompact(v);e.title=resourceCalcFull(v);}}); }
  function resourceCalcRender(){
    const selected=document.querySelector("#oas-rc-selected"); if(!selected)return;
    const rows=resourceCalcLoad();
    selected.innerHTML=rows.length?rows.map(row=>{const item=RESOURCE_CALC_ITEMS.find(x=>x.id===row.id);if(!item)return"";const r=resourceCalcCost(item,row.input);return `<div class="oas-rc-selected-row"><span class="oas-rc-icon">${item.icon}</span><span class="oas-rc-selected-name">${resourceCalcEsc(item.name)}</span><input data-rc-selected="${row.uid}" value="${resourceCalcEsc(row.input)}" title="${item.kind==='level'?'Einzelne Stufe':'Stückzahl'}"><span class="oas-rc-cost" title="M ${resourceCalcFull(r.cost[0])} · K ${resourceCalcFull(r.cost[1])} · D ${resourceCalcFull(r.cost[2])}">${resourceCalcCompact(r.cost[0])} M · ${resourceCalcCompact(r.cost[1])} K · ${resourceCalcCompact(r.cost[2])} D</span><button data-rc-remove="${row.uid}" title="Entfernen">×</button></div>`}).join(""):`<div class="oas-rc-empty">Noch nichts ausgewählt.</div>`;
    selected.querySelectorAll("[data-rc-remove]").forEach(b=>b.addEventListener("click",()=>resourceCalcRemove(b.dataset.rcRemove)));
    selected.querySelectorAll("[data-rc-selected]").forEach(i=>i.addEventListener("change",()=>resourceCalcUpdate(i.dataset.rcSelected,i.value)));
    resourceCalcRenderSummary();
  }
  function resourceCalcOpen(){
    let overlay=document.querySelector("#oas-resource-calculator");
    if(!overlay){ overlay=document.createElement("div");overlay.id="oas-resource-calculator";overlay.className="oas-rc-overlay";
      const cats=RESOURCE_CALC_CATEGORIES.map(cat=>{const items=RESOURCE_CALC_ITEMS.filter(x=>x.cat===cat.id); const body=items.length?items.map(item=>`<div class="oas-rc-item"><span class="oas-rc-icon">${item.icon}</span><span class="oas-rc-name">${resourceCalcEsc(item.name)}</span><input data-rc-input="${item.id}" placeholder="${item.kind==='level'?'Stufe':'Anzahl'}"><button data-rc-add="${item.id}" title="Als neuen Eintrag hinzufügen">+</button></div>`).join(""):`<div class="oas-rc-empty">Wird in einer Folgeversion ergänzt.</div>`; return `<details class="oas-rc-category"><summary>${cat.icon} ${cat.name}<small>${items.length}</small></summary><div class="oas-rc-grid">${body}</div></details>`;}).join("");
      overlay.innerHTML=`<div class="oas-rc-window"><header><div><h2>Ressourcenrechner</h2><small>Jeder Klick fügt einen eigenen Eintrag hinzu: z. B. Astrophysik Stufe 14 und danach Stufe 15.</small></div><button id="oas-rc-close">×</button></header><div class="oas-rc-layout"><section class="oas-rc-categories">${cats}</section><aside class="oas-rc-selection"><h3>Auswahl</h3><div id="oas-rc-selected"></div><div class="oas-rc-summary-card"><h3>Ressourcen</h3><div><span>Metall</span><strong id="oas-rc-metal">0</strong></div><div><span>Kristall</span><strong id="oas-rc-crystal">0</strong></div><div><span>Deuterium</span><strong id="oas-rc-deut">0</strong></div></div><div class="oas-rc-actions"><button id="oas-rc-copy">📋 Kopieren</button><button id="oas-rc-clear">🗑 Leeren</button></div></aside></div></div>`;
      document.body.appendChild(overlay); overlay.querySelector("#oas-rc-close").addEventListener("click",()=>overlay.remove()); overlay.addEventListener("click",e=>{if(e.target===overlay)overlay.remove();}); overlay.querySelectorAll("[data-rc-add]").forEach(b=>b.addEventListener("click",()=>resourceCalcAdd(b.dataset.rcAdd))); overlay.querySelectorAll("[data-rc-input]").forEach(i=>i.addEventListener("keydown",e=>{if(e.key==="Enter")resourceCalcAdd(i.dataset.rcInput);})); overlay.querySelector("#oas-rc-copy").addEventListener("click",resourceCalcCopy); overlay.querySelector("#oas-rc-clear").addEventListener("click",resourceCalcClear);
    }
    resourceCalcRender();
  }

  function createPanel() {
    if (!document.body || document.querySelector("#oas-panel")) return;

    const style = document.createElement("style");
    style.textContent = `
      #oas-panel {
        position: fixed;
        right: 18px;
        top: 18px;
        z-index: 99999;
        width: min(360px, calc(100vw - 28px));
        max-height: calc(100vh - 36px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid rgba(100,216,255,.48);
        border-radius: 14px;
        background: rgba(5,18,32,.97);
        box-shadow: 0 18px 45px rgba(0,0,0,.48);
        color: #eef7ff;
        font: 14px/1.4 Arial, sans-serif;
      }
      #oas-panel * { box-sizing: border-box; }
      #oas-panel input[type="email"], #oas-panel input[type="password"] {
        width: 100%; margin: 5px 0; padding: 8px 9px; border-radius: 7px;
        border: 1px solid #38556b; background: #0a1823; color: #dcebf5;
      }
      #oas-panel .oas-auth-box { padding: 9px; margin-bottom: 10px; border: 1px solid #29485f; border-radius: 8px; background: rgba(9,24,35,.55); }
      #oas-panel [data-kind="success"] { color: #75d69a; }
      #oas-panel [data-kind="error"] { color: #ed8e8e; }
      #oas-panel [data-kind="running"] { color: #efc76a; }
      .oas-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 12px 14px;
        border-bottom: 1px solid rgba(150,190,220,.18);
      }
      .oas-header h3 { margin: 0; font-size: 16px; }
      .oas-version { color: #7f9bb2; font-size: 11px; }
      #oas-toggle {
        display: grid; place-items: center;
        width: 30px; height: 30px; padding: 0;
        border: 1px solid rgba(120,190,230,.28);
        border-radius: 8px; background: rgba(30,70,100,.48);
        color: white; cursor: pointer;
        font: 18px/1 "Segoe UI Emoji", "Apple Color Emoji", sans-serif;
      }
      .oas-content {
        overflow-y: auto;
        padding: 12px;
      }
      .oas-card {
        margin-bottom: 10px;
        padding: 12px;
        border: 1px solid rgba(140,190,220,.18);
        border-radius: 11px;
        background: rgba(12,32,50,.72);
      }
      .oas-card h4 {
        margin: 0 0 10px;
        font-size: 14px;
        color: #8edcff;
      }
      details.oas-card { padding: 0; }
      details.oas-card > summary {
        display: flex; align-items: center; justify-content: space-between;
        padding: 12px; cursor: pointer; list-style: none;
        color: #8edcff; font-weight: 600; user-select: none;
      }
      details.oas-card > summary::-webkit-details-marker { display: none; }
      details.oas-card > summary::after { content: "▸"; color: #8aa9bd; }
      details.oas-card[open] > summary::after { content: "▾"; }
      .oas-collapsible-body { padding: 0 12px 12px; }
      .oas-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin: 6px 0;
        color: #aec2d3;
      }
      .oas-row strong { color: #f0f7fd; text-align: right; }
      #oas-snapshot-state[data-kind="success"] { color: #68e6a3; }
      #oas-snapshot-state[data-kind="running"] { color: #ffd36c; }
      #oas-snapshot-state[data-kind="error"] { color: #ff8290; }
      #oas-optimizer-state[data-kind="success"] { color: #68e6a3; }
      #oas-optimizer-state[data-kind="running"] { color: #ffd36c; }
      #oas-optimizer-state[data-kind="error"] { color: #ff8290; }
      #oas-snapshot-progress {
        width: 100%;
        height: 10px;
        margin: 9px 0 5px;
        accent-color: #63dca0;
      }
      #oas-snapshot-detail {
        min-height: 18px;
        margin-bottom: 9px;
        color: #9fb6c8;
        font-size: 12px;
      }
      .oas-primary, .oas-secondary {
        width: 100%;
        margin-top: 7px;
        padding: 9px 10px;
        border-radius: 8px;
        color: white;
        cursor: pointer;
      }
      .oas-primary {
        border: 1px solid rgba(90,230,155,.45);
        background: #236c47;
      }
      .oas-secondary {
        border: 1px solid rgba(110,190,235,.35);
        background: #173b58;
      }
      button:disabled { opacity: .48; cursor: not-allowed; }
      .oas-status-pill {
        display: inline-block;
        padding: 2px 7px;
        border-radius: 999px;
        background: rgba(80,220,145,.12);
        color: #69e3a3;
        font-size: 12px;
      }
      .oas-muted { color: #829caf; font-size: 12px; }

      .oas-snapshot-item {
        margin-top: 8px;
        padding: 9px;
        border: 1px solid rgba(140,190,220,.16);
        border-radius: 8px;
        background: rgba(0,0,0,.14);
      }
      .oas-snapshot-item-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 4px;
      }
      .oas-pill-warning {
        color: #ffd36c;
        background: rgba(255,200,90,.12);
      }
      .oas-snapshot-item-actions {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 7px;
        margin-top: 7px;
      }
      .oas-snapshot-item-actions button {
        padding: 6px 7px;
        border: 1px solid rgba(110,190,235,.28);
        border-radius: 7px;
        background: #173b58;
        color: white;
        cursor: pointer;
        font-size: 11px;
      }

      #oas-diagnostic-log, #oas-bg-log {
        width: 100%;
        min-height: 170px;
        margin-top: 8px;
        padding: 8px;
        resize: vertical;
        border: 1px solid rgba(150,190,220,.24);
        border-radius: 8px;
        background: rgba(0,0,0,.25);
        color: #dcecff;
        font: 11px/1.45 Consolas, "Courier New", monospace;
      }
      #oas-bg-log { display: none; }
      .oas-hidden-support { display: none !important; }
      #oas-snackbar {
        position: fixed;
        left: 50%;
        bottom: 24px;
        z-index: 100001;
        display: flex;
        align-items: center;
        gap: 10px;
        max-width: min(680px, calc(100vw - 32px));
        padding: 12px 14px;
        border: 1px solid rgba(130,180,220,.45);
        border-radius: 10px;
        background: rgba(10,25,42,.98);
        color: #eef7ff;
        box-shadow: 0 14px 40px rgba(0,0,0,.55);
        opacity: 0;
        pointer-events: none;
        transform: translate(-50%, 20px);
        transition: opacity .18s ease, transform .18s ease;
      }
      #oas-snackbar.oas-visible {
        opacity: 1;
        pointer-events: auto;
        transform: translate(-50%, 0);
      }
      #oas-snackbar[data-kind="success"] { border-color: rgba(80,220,145,.7); }
      #oas-snackbar[data-kind="error"] { border-color: rgba(255,100,120,.75); }
      #oas-snackbar button {
        padding: 6px 9px;
        border: 1px solid rgba(120,200,255,.4);
        border-radius: 7px;
        background: #173a58;
        color: white;
        cursor: pointer;
      }

      #oas-combat-overlay { position:fixed; inset:0; z-index:100001; display:none; padding:28px; background:rgba(0,0,0,.76); color:#eef7ff; font:13px/1.4 Arial,sans-serif; }
      #oas-combat-overlay.open { display:block; }
      .oas-combat-window { height:100%; display:flex; flex-direction:column; overflow:hidden; border:1px solid rgba(255,170,80,.52); border-radius:14px; background:#171006; box-shadow:0 20px 70px rgba(0,0,0,.7); }
      .oas-combat-window header { display:flex; justify-content:space-between; align-items:center; padding:16px 18px; border-bottom:1px solid rgba(255,190,100,.2); }
      .oas-combat-window h2 { margin:0 0 2px; font-size:19px; } .oas-combat-window small { color:#c7aa82; }
      #oas-combat-close { width:36px;height:36px;border:0;border-radius:8px;background:#5a3217;color:white;font-size:26px;cursor:pointer; }
      .oas-combat-section { border-top:1px solid rgba(255,190,100,.18); }
      .oas-combat-section h3 { margin:0;padding:12px 14px 0;color:#ffc574;font-size:14px; }
      .oas-combat-today td { background:rgba(255,180,70,.045); }
      .oas-combat-kpis { display:grid; grid-template-columns:repeat(6,minmax(120px,1fr)); gap:8px; padding:12px; }
      .oas-combat-kpis div { padding:10px;border:1px solid rgba(255,190,100,.2);border-radius:8px;background:#26180b; }
      .oas-combat-kpis span { display:block;color:#c7aa82;font-size:11px; } .oas-combat-kpis strong { display:block;font-size:16px;margin-top:3px; }
      .oas-combat-ships { padding:0 14px 12px;color:#e7c99d; } .oas-combat-table-wrap { flex:1;overflow:auto; }
      .oas-combat-window table { width:100%;border-collapse:collapse;min-width:1050px; } .oas-combat-window th { position:sticky;top:0;background:#35200e;color:#ffc574;text-align:left;padding:9px; }
      .oas-combat-window td { padding:9px;border-bottom:1px solid rgba(255,190,100,.12);vertical-align:top; }
      @media(max-width:900px){#oas-combat-overlay{padding:8px}.oas-combat-kpis{grid-template-columns:1fr 1fr}}

      #oas-panel.oas-collapsed {
        width: 46px; height: 46px; border-radius: 50%; overflow: visible;
        border-color: rgba(100,216,255,.34);
      }
      #oas-panel.oas-collapsed .oas-header {
        width: 44px; height: 44px; padding: 0; border: 0; justify-content: center;
      }
      #oas-panel.oas-collapsed #oas-toggle {
        width: 44px; height: 44px; padding: 0; margin: 0; border: 0; border-radius: 50%;
        background: transparent; box-shadow: none; font-size: 22px; line-height: 1;
      }
      .oas-transport-grid {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 5px 12px;
        margin: 8px 0;
      }
      .oas-transport-grid span { color: #9fb6c8; }
      .oas-transport-grid strong { color: #eef7ff; text-align: right; }
      .oas-transport-total {
        margin-top: 3px;
        padding-top: 6px;
        border-top: 1px solid rgba(140,190,220,.16);
      }

      .oas-transport-add-row { display:flex; justify-content:flex-end; margin:7px 0 0; }
      .oas-transport-add { width:34px; height:30px; min-width:34px; padding:0!important; font-size:21px; line-height:1; font-weight:700; }
      .oas-transport-draft-item { display:flex; flex-direction:column; gap:2px; margin:0 0 5px; padding:7px 8px; border:1px solid rgba(140,190,220,.14); border-radius:7px; background:rgba(0,0,0,.16); }
      .oas-transport-draft-item span { color:#dcecff; font-size:11px; }
      .oas-transport-draft-item small { color:#8faabd; font-size:10px; }
      .oas-transport-snapshot-title, .oas-transport-open-title { margin:12px 0 6px; padding-top:9px; border-top:1px solid rgba(140,190,220,.16); color:#8edcff; font-size:11px; font-weight:700; }
      .oas-transport-saved-list { display:flex; flex-direction:column; gap:5px; }
      .oas-transport-saved-item { display:flex; align-items:flex-start; gap:7px; padding:7px 8px; border:1px solid rgba(140,190,220,.14); border-radius:7px; background:rgba(0,0,0,.18); cursor:pointer; }
      .oas-transport-saved-item input { margin-top:2px; }
      .oas-transport-saved-item span { display:flex; flex-direction:column; gap:2px; min-width:0; }
      .oas-transport-saved-item strong { color:#dcecff; font-size:11px; font-weight:600; }
      .oas-transport-saved-item small { color:#8faabd; font-size:10px; }
      .oas-transport-saved-item.done { opacity:.55; }
      .oas-transport-saved-item.done strong, .oas-transport-saved-item.done small { text-decoration:line-through; }
      .oas-transport-open-grid { margin-top:4px; }
      .oas-transport-saved-cargo { display:flex; justify-content:flex-end; gap:7px; margin:8px 0; padding-top:8px; border-top:1px solid rgba(140,190,220,.16); color:#eef7ff; font-size:11px; }


      .oas-tc-overlay{position:fixed;inset:0;z-index:2147483646;background:rgba(2,8,14,.82);display:flex;align-items:center;justify-content:center;padding:18px}
      .oas-tc-window{width:min(720px,96vw);max-height:94vh;overflow:auto;background:#0c1823;border:1px solid #34516a;border-radius:12px;box-shadow:0 18px 60px #000;color:#dcecff;font:13px Arial,sans-serif}
      .oas-tc-window header{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:#122636;border-bottom:1px solid #29465d}.oas-tc-window h2,.oas-tc-window h3{margin:0}.oas-tc-window header small{color:#8faabd}.oas-tc-window header>button{font-size:24px;background:none;border:0;color:#dcecff;cursor:pointer}
      .oas-tc-body{display:grid;grid-template-columns:minmax(250px,.85fr) minmax(300px,1.15fr);gap:10px;padding:10px}.oas-tc-card,.oas-tc-result{border:1px solid #29465d;border-radius:8px;background:#10202d;padding:10px}.oas-tc-card h3,.oas-tc-result h3{margin:0 0 8px;color:#8edcff}
      .oas-tc-section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:8px}.oas-tc-section-head h3{margin:0!important}.oas-tc-reset{width:28px;height:28px;padding:0;border:1px solid rgba(255,130,144,.45);border-radius:7px;background:rgba(120,25,38,.28);color:#ff9aa6;cursor:pointer;font-size:15px;line-height:1}.oas-tc-reset:hover{background:rgba(150,35,50,.42);color:#fff}.oas-tc-resource-fields{display:flex;flex-direction:column;gap:7px}.oas-tc-resource-fields label{display:grid;grid-template-columns:78px 132px;align-items:center;gap:8px}.oas-tc-resource-fields input{width:132px;max-width:132px;text-align:right;font-variant-numeric:tabular-nums}.oas-tc-card label{color:#9fb6c8}.oas-tc-card input{min-width:0;padding:7px;border:1px solid #31516a;border-radius:6px;background:#07121b;color:#fff}
      .oas-tc-options,.oas-tc-mixed{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.oas-tc-options label,.oas-tc-mixed label{display:flex;flex-direction:row;align-items:center;gap:4px}.oas-tc-mixed{margin-top:10px;padding-top:9px;border-top:1px solid rgba(255,255,255,.08)}.oas-tc-mixed>input{width:105px}.oas-tc-note,#oas-tc-capacity-status{display:block;margin-top:8px;color:#819caf}
      .oas-tc-cap-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.oas-tc-edit-toggle{display:flex;align-items:center;gap:6px;font-size:12px}.oas-tc-edit-toggle input{width:auto}.oas-tc-capacity-list{display:grid;gap:5px;margin-top:8px}.oas-tc-capacity-list>label{display:grid;grid-template-columns:minmax(0,1fr) 112px;align-items:center;gap:12px;padding:6px 8px;border-radius:6px;background:#0a1822}.oas-tc-capacity-list input{width:112px;text-align:right;font-variant-numeric:tabular-nums}.oas-tc-capacity-list input[readonly]{border-color:transparent;background:transparent;color:#fff}.oas-tc-cap-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:8px}.oas-tc-cap-actions button{width:auto}.oas-tc-secondary{display:inline-flex;align-items:center;gap:6px;border:1px solid #3b6784;border-radius:7px;background:linear-gradient(180deg,#183d56,#102b3d);color:#dff4ff;padding:7px 10px;cursor:pointer}.oas-tc-secondary:hover{filter:brightness(1.14)}
      .oas-tc-result{grid-column:1/-1}.oas-tc-result>div{display:flex;justify-content:space-between;gap:15px;padding:6px 2px;border-top:1px solid rgba(255,255,255,.07)}.oas-tc-result>div:first-of-type{border-top:0}.oas-tc-result strong{color:#fff}
      @media(max-width:650px){.oas-tc-body{grid-template-columns:1fr}.oas-tc-result{grid-column:auto}.oas-tc-resource-fields label{grid-template-columns:74px 122px}.oas-tc-resource-fields input{width:122px;max-width:122px}.oas-tc-capacity-list>label{grid-template-columns:minmax(0,1fr) 105px}.oas-tc-capacity-list input{width:105px}}
      .oas-nested-card{margin:0 0 7px;border:1px solid rgba(140,190,220,.15);border-radius:8px;background:rgba(5,20,34,.42)}.oas-nested-card>summary{padding:9px 10px!important}.oas-nested-card .oas-collapsible-body{padding:0 10px 10px}
      @media(max-width:650px){.oas-tc-body{grid-template-columns:1fr}.oas-tc-grid3{grid-template-columns:1fr}.oas-tc-result{grid-column:auto}}
      .oas-rc-overlay{position:fixed;inset:0;z-index:2147483646;background:rgba(2,8,14,.82);display:flex;align-items:center;justify-content:center;padding:18px}
      .oas-rc-window{width:min(1180px,96vw);height:min(820px,94vh);background:#0c1823;border:1px solid #34516a;border-radius:12px;box-shadow:0 18px 60px #000;display:flex;flex-direction:column;overflow:hidden;color:#dcecff;font:13px Arial,sans-serif}
      .oas-rc-window header{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:#122636;border-bottom:1px solid #29465d}.oas-rc-window h2,.oas-rc-window h3{margin:0}.oas-rc-window header small{color:#8faabd}.oas-rc-window header>button{font-size:24px;background:none;border:0;color:#dcecff;cursor:pointer}
      .oas-rc-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(340px,.8fr);gap:10px;min-height:0;flex:1;padding:10px}.oas-rc-categories,.oas-rc-selection{overflow:auto;min-height:0}
      .oas-rc-category{border:1px solid #29465d;border-radius:8px;margin-bottom:6px;background:#10202d}.oas-rc-category>summary{cursor:pointer;padding:8px 10px;font-weight:700;display:flex;gap:8px;align-items:center}.oas-rc-category>summary small{margin-left:auto;color:#7795aa}.oas-rc-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px;padding:0 6px 7px}
      .oas-rc-item,.oas-rc-selected-row{display:grid;align-items:center;gap:6px;background:rgba(255,255,255,.035);border-radius:6px;padding:5px}.oas-rc-item{grid-template-columns:28px minmax(0,1fr) 82px 28px}.oas-rc-icon{width:26px;height:26px;border-radius:5px;background:#193247;display:grid;place-items:center;font-size:17px}.oas-rc-name,.oas-rc-selected-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.oas-rc-item input,.oas-rc-selected-row input{min-width:0;background:#07121b;border:1px solid #31516a;color:#fff;border-radius:5px;padding:5px}.oas-rc-item button,.oas-rc-selected-row button,.oas-rc-actions button{border:1px solid #3b6784;background:#173951;color:#e9f7ff;border-radius:5px;cursor:pointer;padding:5px}
      .oas-rc-selection{border:1px solid #29465d;border-radius:8px;padding:9px;background:#0d1d29;overflow-x:hidden}.oas-rc-selection h3{margin-bottom:7px}.oas-rc-selected-row{grid-template-columns:26px minmax(0,1fr) 62px 28px;grid-template-areas:"icon name input remove" "icon cost cost remove";margin-bottom:4px;max-width:100%;overflow:hidden}.oas-rc-selected-row>.oas-rc-icon{grid-area:icon}.oas-rc-selected-name{grid-area:name;min-width:0}.oas-rc-selected-row>input{grid-area:input;width:100%;box-sizing:border-box}.oas-rc-cost{grid-area:cost;text-align:left;color:#9fc1d7;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}.oas-rc-selected-row>button{grid-area:remove;width:28px;height:100%;min-height:28px;padding:0;position:sticky;right:0}.oas-rc-empty{padding:12px;color:#7894a8;text-align:center}.oas-rc-summary-card{margin-top:10px;border:1px solid #31516a;border-radius:8px;background:#102433;padding:9px}.oas-rc-summary-card h3{margin:0 0 6px}.oas-rc-summary-card>div{display:flex;justify-content:space-between;gap:12px;padding:5px 2px;border-top:1px solid rgba(255,255,255,.07)}.oas-rc-summary-card>div:first-of-type{border-top:0}.oas-rc-summary-card strong{color:#fff}.oas-rc-actions{display:flex;gap:6px;margin-top:10px}
      @media(max-width:850px){.oas-rc-layout{grid-template-columns:1fr}.oas-rc-selection{max-height:48vh}.oas-rc-grid{grid-template-columns:1fr}}
      .oas-header-actions {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-left: auto;
      }
      .oas-header-icon {
        width: 30px;
        height: 30px;
        padding: 0;
        border: 1px solid rgba(105,190,235,.28);
        border-radius: 7px;
        background: rgba(20,55,80,.75);
        color: #dff4ff;
        cursor: pointer;
        font-size: 17px;
        line-height: 1;
      }
      .oas-header-icon:hover:not(:disabled) {
        filter: brightness(1.18);
      }
      .oas-header-icon:disabled {
        opacity: .65;
        cursor: default;
      }
      #oas-panel.oas-collapsed .oas-header-title,
      #oas-panel.oas-collapsed .oas-header-actions > :not(#oas-toggle),
      #oas-panel.oas-collapsed .oas-content { display: none; }
    `;
    document.head.appendChild(style);

    const panel = document.createElement("aside");
    panel.id = "oas-panel";
    panel.innerHTML = `
      <div class="oas-header">
        <div class="oas-header-title">
          <h3>OGame Stats Companion</h3>
          <div class="oas-version">Collector 7.16.0 · Supabase Sync</div>
        </div>
        <span class="oas-header-actions">
          <button id="oas-player-snapshot" class="oas-header-icon" type="button"
            title="Spieler-Snapshot erstellen" aria-label="Spieler-Snapshot erstellen">↻</button>
          <button id="oas-open-dashboard-header" class="oas-header-icon" type="button"
            title="OGame Stats öffnen" aria-label="OGame Stats öffnen">↗</button>
          <button id="oas-toggle" type="button">−</button>
        </span>
      </div>

      <div class="oas-content">

        <details class="oas-card oas-collapsible">
          <summary>⚔️ Kampfberichte Loot</summary>
          <div class="oas-collapsible-body">
            <div class="oas-row"><span>Lokale Auswertung</span><strong id="oas-combat-state">0 Berichte lokal</strong></div>
            <button id="oas-combat-update" class="oas-primary" type="button">⚔️ Kampfberichte Loot einlesen</button>
            <button id="oas-combat-open" class="oas-secondary" type="button">📋 Loot-Übersicht öffnen</button>
            <button id="oas-combat-reset" class="oas-secondary" type="button">🗑️ Kampfberichtsdaten zurücksetzen</button>
            <div class="oas-muted" style="margin-top:8px">
              Öffne zuerst Nachrichten → Kampfberichte. Der Companion summiert erbeutete Rohstoffe, den Ressourcenwert eigener Schiffsverluste und verlorene Schiffstypen. Alles bleibt lokal im Browser.
            </div>
          </div>
        </details>

        <details class="oas-card oas-collapsible">
          <summary>🚚 Transport-Notiz</summary>
          <div class="oas-collapsible-body">
            <div id="oas-transport-status" class="oas-muted" style="margin-bottom:8px">
              Bereit für eine neue Transport-Notiz.
            </div>

            <div id="oas-transport-draft-list"></div>

            <button id="oas-transport-read" class="oas-primary" type="button">
              📥 Fehlende Ressourcen übernehmen
            </button>

            <div class="oas-transport-add-row">
              <button id="oas-transport-add" class="oas-secondary oas-transport-add" type="button"
                title="Aktuellen Ausbau zusätzlich übernehmen">＋</button>
            </div>

            <div class="oas-transport-grid">
              <span>Metall</span><strong id="oas-transport-metal">0</strong>
              <span>Kristall</span><strong id="oas-transport-crystal">0</strong>
              <span>Deuterium</span><strong id="oas-transport-deuterium">0</strong>
              <span class="oas-transport-total">Gesamt</span>
              <strong id="oas-transport-total" class="oas-transport-total">0</strong>
              <span>Große Transporter (GT)</span><strong id="oas-transport-gt">0</strong>
              <span>Kleine Transporter (KT = GT × 5)</span><strong id="oas-transport-kt">0</strong>
            </div>

            <button id="oas-transport-save" class="oas-primary" type="button">
              💾 Transport-Info speichern
            </button>
            <button id="oas-transport-clear" class="oas-secondary" type="button">
              🗑️ Entwurf löschen
            </button>

            <div class="oas-transport-snapshot-title">Gespeicherte Transport-Info</div>
            <div id="oas-transport-saved"></div>

            <div class="oas-muted" style="margin-top:8px">
              Der erste Ausbau wird übernommen, weitere mit [+] ergänzt. Beim Speichern entsteht genau
              ein Supabase-Snapshot. Häkchen reduzieren nur „Noch zu schicken“; GT/KT bleiben für den
              vollständigen Planet-Hopping-Plan unverändert.
            </div>
          </div>
        </details>
        <details class="oas-card oas-collapsible">
          <summary>🧮 Ressourcenrechner</summary>
          <div class="oas-collapsible-body">
            <button id="oas-resource-calc-open" class="oas-primary" type="button">🧮 Rechner öffnen</button>
            <div class="oas-muted" style="margin-top:8px">Kombiniert Gebäude, Forschungen, Schiffe und Verteidigung in einer gemeinsamen Rechnung. Die Auswahl bleibt lokal gespeichert.</div>
          </div>
        </details>

        <details class="oas-card oas-collapsible">
          <summary>🚀 Transportrechner</summary>
          <div class="oas-collapsible-body">
            <button id="oas-transport-calc-open" class="oas-primary" type="button">🚀 Rechner öffnen</button>
            <div class="oas-muted" style="margin-top:8px">Berechnet KT, GT oder eine Mischflotte. Bei „beide“ wird die vorhandene Anzahl eines Transportertyps zuerst abgezogen und der Rest mit dem anderen Typ ergänzt.</div>
          </div>
        </details>

        <details class="oas-card oas-collapsible">
          <summary>📈 Optimizer</summary>
          <div class="oas-collapsible-body">
            <div class="oas-row"><span>Accountdaten</span><strong id="oas-optimizer-state" data-kind="idle">Noch nicht aktualisiert</strong></div>
            <div id="oas-optimizer-detail" class="oas-muted">
              Noch keine Optimizer-Daten ausgelesen. Der Abruf wird nicht gespeichert.
            </div>
            <button id="oas-optimizer-refresh" class="oas-primary" type="button">🔄 Accountdaten aktualisieren</button>
            <button id="oas-optimizer-open" class="oas-secondary" type="button" disabled>📈 Optimizer öffnen</button>
            <div class="oas-muted" style="margin-top:8px">
              Liest die aktuelle Imperiumsansicht ausschließlich für den Optimizer. Der Abruf dient ausschließlich dem Optimizer und wird nicht als Spieler-Snapshot gespeichert.
            </div>
          </div>
        </details>

        <details class="oas-card oas-collapsible">
          <summary>👤 Spielerdaten</summary>
          <div class="oas-collapsible-body">
            <div class="oas-auth-box">
              <div class="oas-row">
                <span>Supabase</span>
                <strong id="oas-supabase-state" data-kind="idle">Nicht angemeldet</strong>
              </div>
              <input id="oas-supabase-email" type="email" autocomplete="username" placeholder="E-Mail">
              <input id="oas-supabase-password" type="password" autocomplete="current-password" placeholder="Passwort">
              <button id="oas-supabase-login" class="oas-secondary" type="button">🔐 Bei Supabase anmelden</button>
              <button id="oas-supabase-logout" class="oas-secondary" type="button" hidden>Abmelden</button>
            </div>

            <div class="oas-row"><span>Spieler</span><strong id="oas-player-name">–</strong></div>
            <div class="oas-row"><span>Player-ID</span><strong id="oas-player-id">–</strong></div>
            <div class="oas-row"><span>Universum</span><strong id="oas-player-universe">–</strong></div>
            <div class="oas-row">
              <span>Letzter Spieler-Snapshot</span>
              <strong id="oas-player-last-snapshot">Noch keiner</strong>
            </div>
            <div class="oas-row">
              <span>Snapshot-Status</span>
              <strong id="oas-player-snapshot-state" data-kind="idle">Bereit</strong>
            </div>

            <details class="oas-collapsible oas-nested-card">
              <summary>📋 Diagnose</summary>
              <div class="oas-collapsible-body">
                <div class="oas-muted">Nur bei Collector- oder Parser-Problemen nötig.</div>
                <textarea id="oas-diagnostic-log" readonly
                  placeholder="Nach einem Spieler-Snapshot erscheint hier das Diagnose-Log."></textarea>
                <button id="oas-diagnostic-copy" class="oas-secondary" type="button" disabled>📋 Log kopieren</button>
                <button id="oas-diagnostic-clear" class="oas-secondary" type="button">🗑 Diagnose löschen</button>
              </div>
            </details>
          </div>
        </details>
        <section class="oas-card">
          <h4>🌌 Expeditionen</h4>
          <div class="oas-muted">
            Vorbereitet für eine spätere eigenständige Expeditionsauswertung.
          </div>
        </section>


        <div class="oas-hidden-support">
          <div id="oas-bg-status"></div>
          <div id="oas-bg-progress"></div>
          <textarea id="oas-bg-log" readonly></textarea>
          <button id="oas-bg-copy" type="button"></button>
        </div>
      </div>
    `;

    document.body.appendChild(panel);
    initPanelDetailsState(panel);

    const bindPanelEvent = (selector, eventName, handler) => {
      const element = panel.querySelector(selector);
      if (!element) {
        console.warn(`[OGame Companion] Bedienelement fehlt: ${selector}`);
        return;
      }
      element.addEventListener(eventName, handler);
    };

    bindPanelEvent("#oas-toggle", "click", () => setCollapsed(!isCollapsed()));
    bindPanelEvent("#oas-player-snapshot", "click", runPlayerSnapshotFromHeader);
    bindPanelEvent("#oas-open-dashboard-header", "click", openDashboard);
    bindPanelEvent("#oas-supabase-login", "click", handleSupabaseLogin);
    bindPanelEvent("#oas-supabase-logout", "click", handleSupabaseLogout);
    bindPanelEvent("#oas-resource-calc-open", "click", resourceCalcOpen);
    bindPanelEvent("#oas-transport-calc-open", "click", transportCalcOpen);
    bindPanelEvent("#oas-optimizer-refresh", "click", refreshOptimizerSnapshot);
    bindPanelEvent("#oas-optimizer-open", "click", openOptimizer);
    bindPanelEvent("#oas-combat-update", "click", combatUpdateReports);
    bindPanelEvent("#oas-combat-open", "click", combatOpenOverlay);
    bindPanelEvent("#oas-combat-reset", "click", combatReset);
    bindPanelEvent("#oas-transport-read", "click", () => {
      try { transportNoteReadCurrentPage(); }
      catch (error) { showMessage(`Übernahme fehlgeschlagen: ${error.message}`, "error"); }
    });
    bindPanelEvent("#oas-transport-add", "click", () => {
      try { transportNoteAddCurrentPage(); }
      catch (error) { showMessage(`Hinzufügen fehlgeschlagen: ${error.message}`, "error"); }
    });
    bindPanelEvent("#oas-transport-save", "click", () => {
      transportNoteSaveSnapshot().catch(error =>
        showMessage(`Speichern fehlgeschlagen: ${error.message}`, "error")
      );
    });
    bindPanelEvent("#oas-transport-clear", "click", transportNoteClear);
    bindPanelEvent("#oas-diagnostic-copy", "click", copyCleanDiagnosticLog);
    updateSupabaseAuthUi();
    bindPanelEvent("#oas-diagnostic-clear", "click", () => {
      clearBackgroundCollectorTest();
      updateCleanCompanionUi();
    });

    const safePanelInit = (name, fn) => {
      try { fn(); }
      catch (error) { console.error(`[OGame Companion] ${name} fehlgeschlagen`, error); }
    };
    safePanelInit("Statusanzeige", updateCleanCompanionUi);
    safePanelInit("Optimizer-Anzeige", updateOptimizerUi);
    safePanelInit("Kampfbericht-Anzeige", combatRender);
    safePanelInit("Transport-Notiz", transportNoteRender);
    if (loadSupabaseSession()?.access_token) {
      transportNoteLoadRemote().catch(error =>
        console.warn("[OGame Companion] Transport-Info konnte nicht geladen werden", error)
      );
    }
    safePanelInit("Panelzustand", applyCollapsedState);
    document.querySelector("#oas-emergency-launcher")?.remove();
  }

  function ensureEmergencyLauncher(error = null) {
    if (!document.body || document.querySelector("#oas-panel") || document.querySelector("#oas-emergency-launcher")) return;
    const launcher = document.createElement("button");
    launcher.id = "oas-emergency-launcher";
    launcher.type = "button";
    launcher.textContent = "🚀";
    launcher.title = error ? "Companion-Start fehlgeschlagen – anklicken und Konsole prüfen" : "OGame Stats Companion öffnen";
    launcher.setAttribute("aria-label", launcher.title);
    Object.assign(launcher.style, {
      position: "fixed", right: "18px", top: "18px", zIndex: "2147483647",
      width: "48px", height: "48px", borderRadius: "50%", cursor: "pointer",
      border: "1px solid rgba(100,216,255,.7)", background: "rgba(5,18,32,.98)",
      color: "white", fontSize: "23px", lineHeight: "1", boxShadow: "0 8px 24px rgba(0,0,0,.55)"
    });
    launcher.addEventListener("click", () => {
      try {
        createPanel();
        const panel = document.querySelector("#oas-panel");
        if (panel) {
          setCollapsed(false);
          launcher.remove();
        }
      } catch (clickError) {
        console.error("[OGame Companion] Manueller Panelstart fehlgeschlagen", clickError);
        launcher.title = `Companion-Fehler: ${clickError?.message || clickError}`;
      }
    });
    document.body.appendChild(launcher);
  }

  // OGame lädt Inhalte dynamisch. Panel bzw. Notfall-Starter bleiben erhalten.
  const observer = new MutationObserver(() => {
    if (!document.body) return;
    if (!document.querySelector("#oas-panel")) ensureEmergencyLauncher();
  });

  function startCompanion() {
    ensureEmergencyLauncher();
    try {
      createPanel();
    } catch (error) {
      console.error("[OGame Companion] Initialisierung fehlgeschlagen", error);
      ensureEmergencyLauncher(error);
    }
    try {
      if (document.documentElement) {
        observer.observe(document.documentElement, { childList: true, subtree: true });
      }
    } catch (error) {
      console.error("[OGame Companion] DOM-Beobachter fehlgeschlagen", error);
    }
}

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startCompanion, { once: true });
  } else {
    startCompanion();
  }
})();

// ==UserScript==
// @name         OGame Stats Companion
// @namespace    https://github.com/XellDincht/ogame-stats
// @version      7.16.0
// @description  Bereinigter OGame Companion mit Spieler-Snapshot, Supabase-Sync, Kampfberichte, Transport-Notiz und Rechnern.
// @match        https://s282-de.ogame.gameforge.com/game/index.php*
// @grant        GM_xmlhttpRequest
// @grant        GM_setClipboard
// @grant        unsafeWindow
// @grant        GM_openInTab
// @connect      qtegrndpcbuwuvxpphld.supabase.co
// @updateURL    https://raw.githubusercontent.com/XellDincht/ogame-stats/main/userscripts/OGame-Stats-Companion.user.js
// @downloadURL  https://raw.githubusercontent.com/XellDincht/ogame-stats/main/userscripts/OGame-Stats-Companion.user.js
// ==/UserScript==

(() => {
  "use strict";

  const PANEL_STATE_KEY = "ogameAllianceShipPanelCollapsedV1";
  const PANEL_DETAILS_STATE_KEY = "ogameCompanionDetailsOpenStateV1";
  const DASHBOARD_URL = "https://xelldincht.github.io/ogame-stats/index.html";
  const OPTIMIZER_HTML_BASE64 = "";

  // Der Optimizer-Snapshot lebt nur im Arbeitsspeicher dieser Seite.
  // Er wird weder in localStorage gespeichert noch an die lokale Bridge übertragen.
  let optimizerSnapshot = null;
  let optimizerSnapshotRunning = false;

  // Seit 7.5.0 entfernt: alte Allianz-Highscore-Erfassung, manueller
  // Expeditions-Collector und AGO/AGR-Scanner. Der aktive Workflow nutzt
  // ausschließlich den Empire-Snapshot und die lokale Bridge.

  const BACKGROUND_TEST_STORAGE_KEY = "oasBackgroundCollectorTestV620";
  const BACKGROUND_COMPONENTS = [
    { id: "overview", label: "Übersicht / Planetendaten", hints: ["Übersicht", "Durchmesser", "Metall"] },
    { id: "resourcesettings", label: "Ressourceneinstellungen / Produktion", hints: ["Ressourceneinstellungen", "Produktion", "Metall"] },
    { id: "supplies", label: "Versorgung", hints: ["Metallmine", "Kristallmine", "Deuterium"] },
    { id: "facilities", label: "Anlagen", hints: ["Roboterfabrik", "Raumschiffwerft", "Forschungslabor"] },
    { id: "research", label: "Forschung", hints: ["Forschung", "Technik", "Astrophysik"] },
    { id: "shipyard", label: "Schiffswerft", hints: ["Schiffswerft", "Transporter", "Jäger"] },
    { id: "defenses", label: "Verteidigung", hints: ["Verteidigung", "Raketenwerfer", "Schildkuppel"] }
  ];

  // Monde sind nicht Bestandteil des schnellen Empire-Payloads.
  // Sie werden über ihre eigenen cp-Links separat gelesen.
  const MOON_BACKGROUND_COMPONENTS = BACKGROUND_COMPONENTS.filter(component =>
    ["overview", "facilities", "shipyard", "defenses"].includes(component.id)
  );

  let backgroundCollectorRunning = false;

  const wait = milliseconds =>
    new Promise(resolve => window.setTimeout(resolve, milliseconds));






  function technologyNumber(value) {
    if (value === null || value === undefined || value === "") return null;
    const normalized = String(value)
      .replace(/\u00a0/g, " ")
      .replace(/[^\d.,+-]/g, "")
      .replace(/\./g, "")
      .replace(",", ".");
    const parsed = Number(normalized);
    return Number.isFinite(parsed) ? parsed : null;
  }

  function extractFirstNumber(text, patterns) {
    for (const pattern of patterns) {
      const match = String(text || "").match(pattern);
      if (match) {
        const value = technologyNumber(match[1]);
        if (value !== null) return value;
      }
    }
    return null;
  }


  const TECHNOLOGY_ID_RANGES = {
    supplies: new Set(["1", "2", "3", "4", "12", "22", "23", "24"]),
    facilities: new Set(["14", "15", "21", "31", "33", "34", "36", "41", "42", "43", "44"]),
    research: new Set([
      "106", "108", "109", "110", "111", "113", "114", "115",
      "117", "118", "120", "121", "122", "123", "124", "199"
    ]),
    shipyard: new Set([
      "202", "203", "204", "205", "206", "207", "208", "209",
      "210", "211", "212", "213", "214", "215", "217", "218", "219"
    ]),
    defenses: new Set([
      "401", "402", "403", "404", "405", "406", "407", "408",
      "502", "503"
    ])
  };

  function cleanTechnologyName(value) {
    let name = String(value || "")
      .replace(/<br\s*\/?>/gi, " ")
      .replace(/\s+/g, " ")
      .trim();

    const stopPhrases = [
      "Bauliste ist voll.",
      "Forschungsliste ist voll.",
      "Vorbedingungen nicht erfüllt",
      "Nicht genug Ressourcen",
      "Es wird zurzeit geforscht.",
      "Die Schiffswerft ist noch beschäftigt.",
      "Schiffswerft ist noch beschäftigt.",
      "Die Werft ist noch beschäftigt.",
      "Um dieses Schiff bauen zu können",
      " auf Stufe "
    ];

    for (const phrase of stopPhrases) {
      const index = name.indexOf(phrase);
      if (index > 0) name = name.slice(0, index).trim();
    }

    return name
      .replace(/\s+\(\d[\d.]*\)\s*$/, "")
      .trim();
  }

  function cleanTechnologyList(component, technologies) {
    const allowed = TECHNOLOGY_ID_RANGES[component];
    const byId = new Map();

    for (const technology of technologies || []) {
      const id = technology?.id ? String(technology.id) : "";
      if (!id || (allowed && !allowed.has(id))) continue;

      const level = Number.isFinite(Number(technology.level))
        ? Number(technology.level)
        : null;
      if (level === null) continue;

      const candidate = {
        id,
        name: cleanTechnologyName(technology.name),
        value: level,
        level,
        amount: level
      };

      const current = byId.get(id);
      if (!current || current.level === null) byId.set(id, candidate);
    }

    return Array.from(byId.values())
      .sort((a, b) => Number(a.id) - Number(b.id));
  }

  function parseFactNumber(value) {
    if (value === null || value === undefined) return null;
    const match = String(value)
      .replace(/\u00a0/g, " ")
      .match(/[-+]?\d[\d.]*/);
    if (!match) return null;
    const parsed = Number(match[0].replace(/\./g, ""));
    return Number.isFinite(parsed) ? parsed : null;
  }

  function overviewFact(item, key) {
    const facts = item.overview_facts || {};
    return facts[key] ?? null;
  }

  function parseOverviewData(item) {
    const diameter = parseFactNumber(overviewFact(item, "diameter"));
    const fieldsUsed = parseFactNumber(overviewFact(item, "fields_used"));
    const fieldsTotal = parseFactNumber(overviewFact(item, "fields_total"));
    const temperatureMin = parseFactNumber(
      overviewFact(item, "temperature_min")
    );
    const temperatureMax = parseFactNumber(
      overviewFact(item, "temperature_max")
    );

    return {
      diameter_km: diameter,
      fields_used: fieldsUsed,
      fields_total: fieldsTotal,
      temperature_min_c: temperatureMin,
      temperature_max_c: temperatureMax,
      raw_hints: {
        returned_planet_name: item.returned_planet_name || null,
        returned_coordinates: item.returned_coordinates || null,
        selectors: item.overview_fact_sources || {}
      }
    };
  }


  function classifyTechnology(component, technology) {
    const bucketMap = {
      supplies: "buildings",
      facilities: "facilities",
      research: "research",
      shipyard: "ships",
      defenses: "defenses"
    };
    return [bucketMap[component] || null, technology];
  }


  function moduleResultToSnapshotPlanet(body) {
    const planet = {
      id: body.id,
      name: body.name,
      coordinates: body.coordinates || null,
      type: body.type || "planet",
      order: Number.isFinite(Number(body.order)) ? Number(body.order) : null,
      parent_planet_id: body.parent_planet_id ?? null,
      image_url: body.image_url || null,
      background_image_url: body.background_image_url || null,
      overview: {
        diameter_km: body.diameter_km ?? null,
        fields_used: body.fields_used ?? null,
        fields_total: body.fields_total ?? null,
        temperature_min_c: body.temperature_min_c ?? null,
        temperature_max_c: body.temperature_max_c ?? null,
        raw_hints: { source: "planet_bar_tooltip" }
      },
      buildings: [],
      facilities: [],
      research: [],
      ships: [],
      defenses: [],
      production: {
        metal_per_hour: null,
        crystal_per_hour: null,
        deuterium_per_hour: null,
        energy_available: null,
        energy_production: null,
        metal_current: null,
        crystal_current: null,
        deuterium_current: null,
        metal_storage: null,
        crystal_storage: null,
        deuterium_storage: null,
        source: "not_yet_resolved"
      },
      modules: {},
      complete: true,
      missing: []
    };

    for (const item of body.results || []) {
      planet.modules[item.component] = {
        ok: Boolean(item.ok),
        parser_ok: Boolean(item.parser_ok),
        status: item.status,
        bytes: item.bytes,
        technology_count: item.technology_count || 0,
        warnings: item.parser_warnings || [],
        errors: item.errors || []
      };

      if (!item.ok) {
        planet.complete = false;
        planet.missing.push(item.component);
      }

      if (item.component === "overview") {
        const parsedOverview = parseOverviewData(item);
        planet.overview = {
          diameter_km: parsedOverview.diameter_km ?? planet.overview.diameter_km,
          fields_used: parsedOverview.fields_used ?? planet.overview.fields_used,
          fields_total: parsedOverview.fields_total ?? planet.overview.fields_total,
          temperature_min_c: parsedOverview.temperature_min_c ?? planet.overview.temperature_min_c,
          temperature_max_c: parsedOverview.temperature_max_c ?? planet.overview.temperature_max_c,
          raw_hints: parsedOverview.raw_hints || planet.overview.raw_hints
        };
      }

      if (item.production_data) {
        planet.production = {
          ...planet.production,
          ...item.production_data
        };
      }

      let cleanedTechnologies =
        cleanTechnologyList(item.component, item.technologies || []);
      if (planet.type === "moon" && item.component === "facilities") {
        const moonFacilityIds = new Set(["41", "42", "43"]);
        cleanedTechnologies = cleanedTechnologies.filter(technology =>
          moonFacilityIds.has(String(technology.id))
        );
      }
      for (const technology of cleanedTechnologies) {
        const [bucket, normalized] =
          classifyTechnology(item.component, technology);
        if (bucket) planet[bucket].push(normalized);
      }
    }

    // Forschung ist accountweit. Sie bleibt trotzdem beim Planetendatensatz
    // erhalten; beim Dashboard kann später der erste vollständige Satz genutzt werden.
    return planet;
  }

  function buildAtomicSnapshot(result) {
    const finishedAt = result.finished_at || new Date().toISOString();
    const planets = (result.bodies || []).map(moduleResultToSnapshotPlanet);

    const missing = [];
    for (const planet of planets) {
      for (const component of planet.missing) {
        missing.push({
          planet_id: planet.id,
          planet_name: planet.name,
          coordinates: planet.coordinates,
          component
        });
      }
    }

    const accountResearch = new Map();
    for (const planet of planets) {
      for (const technology of planet.research || []) {
        const current = accountResearch.get(technology.id);
        if (!current || technology.level > current.level) {
          accountResearch.set(technology.id, technology);
        }
      }
    }

    const parserOpen = [];
    for (const planet of planets) {
      for (const [component, module] of Object.entries(planet.modules)) {
        if (module.ok && !module.parser_ok) {
          parserOpen.push({
            planet_id: planet.id,
            planet_name: planet.name,
            component
          });
        }
      }
    }

    return {
      format: "ogame-account-snapshot-v1",
      schema_version: 1,
      collector_version: "7.16.0",
      snapshot_id:
        `${result.universe || location.host}:` +
        `${result.player_id || "unknown"}:` +
        `${finishedAt}`,
      created_at: finishedAt,
      collection_started_at: result.started_at,
      collection_finished_at: finishedAt,
      player: {
        id: result.player_id || null,
        name: result.player_name || null
      },
      universe: result.universe || location.host,
      complete: missing.length === 0,
      upload_status: "LOCAL_ONLY",
      uploaded_at: null,
      account: {
        research: Array.from(accountResearch.values()).sort((a, b) => Number(a.id) - Number(b.id)),
        active_flights: collectActiveFlights(document)
      },
      planets,
      summary: {
        planet_count: planets.filter(item => item.type !== "moon").length,
        moon_count: planets.filter(item => item.type === "moon").length,
        active_flight_count: collectActiveFlights(document).length,
        module_count: planets.reduce(
          (sum, planet) => sum + Object.keys(planet.modules).length,
          0
        ),
        technology_records: planets.reduce(
          (sum, planet) =>
            sum +
            planet.buildings.length +
            planet.facilities.length +
            planet.research.length +
            planet.ships.length +
            planet.defenses.length,
          0
        ),
        missing_modules: missing,
        parser_open_modules: parserOpen
      }
    };
  }


  function saveBackgroundTest(result) {
    localStorage.setItem(
      BACKGROUND_TEST_STORAGE_KEY,
      JSON.stringify(result)
    );
  }

  function loadBackgroundTest() {
    try {
      return JSON.parse(
        localStorage.getItem(BACKGROUND_TEST_STORAGE_KEY) || "null"
      );
    } catch (_) {
      return null;
    }
  }

  function metaFromDocument(doc, name) {
    return (
      doc.querySelector(`meta[name="${name}"]`)?.content ||
      doc.querySelector(`meta#${name}`)?.content ||
      ""
    );
  }

  function normalizeBackgroundText(value) {
    return String(value || "").replace(/\s+/g, " ").trim();
  }

  function discoverOwnCelestialBodies() {
    const found = new Map();
    const smallPlanets = Array.from(document.querySelectorAll("#planetList .smallplanet, #myPlanets .smallplanet"));

    const tooltipData = anchor => {
      const raw = anchor?.getAttribute("data-tooltip-title") || anchor?.getAttribute("title") || "";
      const plain = String(raw)
        .replace(/<br\s*\/?>/gi, "\n")
        .replace(/<[^>]+>/g, "")
        .replace(/&nbsp;/gi, " ")
        .replace(/\r/g, "")
        .trim();
      const headline = plain.split("\n").find(Boolean) || "";
      const match = headline.match(/^(.+?)\s*\[(\d+:\d+:\d+)\]/);
      const details = parsePlanetTooltip(raw);
      return {
        name: match?.[1]?.trim() || "",
        coordinates: match?.[2] || "",
        diameter_km: details.diameter_km,
        fields_used: details.fields_used,
        fields_total: details.fields_total,
        temperature_min_c: details.temperature_min_c,
        temperature_max_c: details.temperature_max_c
      };
    };

    const addAnchor = (anchor, type, parentPlanetId = null, fallbackCoordinates = "") => {
      if (!anchor) return;
      const href = anchor.getAttribute("data-link") || anchor.getAttribute("href") || "";
      let url;
      try { url = new URL(href, location.href); }
      catch (_) { return; }

      const id = String(url.searchParams.get("cp") || "").replace(/[^\d]/g, "");
      if (!id) return;

      const tooltip = tooltipData(anchor);
      const container = anchor.closest(".smallplanet");
      const coordinates =
        tooltip.coordinates ||
        fallbackCoordinates ||
        container?.querySelector(".planet-koords")?.textContent?.replace(/[\[\]]/g, "").trim() ||
        "";

      const image = anchor.querySelector("img");
      const name =
        tooltip.name ||
        image?.getAttribute("alt")?.trim() ||
        (type === "planet"
          ? container?.querySelector(".planet-name")?.textContent?.trim()
          : "") ||
        `${type === "moon" ? "Mond" : "Planet"} ${id}`;

      url.searchParams.set("page", "ingame");
      url.searchParams.set("component", "overview");
      url.searchParams.set("cp", id);

      found.set(`${type}:${id}`, {
        id: Number(id),
        name,
        coordinates,
        type,
        parent_planet_id: parentPlanetId ? Number(parentPlanetId) : null,
        image_url: image?.src || image?.getAttribute("data-default-src") || null,
        diameter_km: tooltip.diameter_km,
        fields_used: tooltip.fields_used,
        fields_total: tooltip.fields_total,
        temperature_min_c: tooltip.temperature_min_c,
        temperature_max_c: tooltip.temperature_max_c,
        baseUrl: url.toString()
      });
    };

    for (const container of smallPlanets) {
      const planetLink = container.querySelector(":scope > .planetlink, .planetlink");
      const planetHref = planetLink?.getAttribute("data-link") || planetLink?.getAttribute("href") || "";
      let planetId = null;
      try {
        planetId = new URL(planetHref, location.href).searchParams.get("cp");
      } catch (_) {}

      const planetCoordinates =
        container.querySelector(".planet-koords")?.textContent?.replace(/[\[\]]/g, "").trim() ||
        tooltipData(planetLink).coordinates ||
        "";

      addAnchor(planetLink, "planet", null, planetCoordinates);

      const moonLink = container.querySelector(":scope > .moonlink, .moonlink");
      addAnchor(moonLink, "moon", planetId, planetCoordinates);
    }

    // Sicherheitsnetz für die aktuell aktive Himmelskörper-ID.
    const currentId = metaFromDocument(document, "ogame-planet-id");
    if (currentId) {
      const currentType =
        String(metaFromDocument(document, "ogame-planet-type") || "planet").toLowerCase() === "moon"
          ? "moon"
          : "planet";
      const key = `${currentType}:${currentId}`;
      if (!found.has(key)) {
        const url = new URL(location.href);
        url.searchParams.set("page", "ingame");
        url.searchParams.set("component", "overview");
        url.searchParams.set("cp", currentId);
        found.set(key, {
          id: Number(currentId),
          name: metaFromDocument(document, "ogame-planet-name") || `Objekt ${currentId}`,
          coordinates: metaFromDocument(document, "ogame-planet-coordinates"),
          type: currentType,
          parent_planet_id: null,
          image_url: null,
          baseUrl: url.toString()
        });
      }
    }

    const bodies = Array.from(found.values());
    const planets = bodies.filter(body => body.type === "planet");
    const moons = bodies.filter(body => body.type === "moon");

    const planetOrder = new Map(planets.map((body, index) => [String(body.id), index]));
    return [
      ...planets.map((body, index) => ({ ...body, order: index })),
      ...moons.map((body, index) => ({
        ...body,
        order: planetOrder.get(String(body.parent_planet_id)) ?? (planets.length + index)
      }))
    ];
  }

  function buildBackgroundUrl(body, component) {
    const url = new URL(body.baseUrl, location.href);
    url.searchParams.set("page", "ingame");
    url.searchParams.set("component", component);
    url.searchParams.set("cp", String(body.id));
    url.hash = "";
    return url.toString();
  }




  const SUPABASE_URL = "https://qtegrndpcbuwuvxpphld.supabase.co";
  const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_8tHaQcq3UDTHiG3o2J996w_s1k4SgM_";
  const SUPABASE_UPLOAD_URL = `${SUPABASE_URL}/functions/v1/upload-ogame-account`;
  const SUPABASE_SESSION_KEY = "oasSupabaseSessionV1";

  function loadSupabaseSession() {
    try {
      const value = JSON.parse(localStorage.getItem(SUPABASE_SESSION_KEY) || "null");
      return value && typeof value === "object" ? value : null;
    } catch (_) {
      return null;
    }
  }

  function saveSupabaseSession(session) {
    if (!session) localStorage.removeItem(SUPABASE_SESSION_KEY);
    else localStorage.setItem(SUPABASE_SESSION_KEY, JSON.stringify(session));
    updateSupabaseAuthUi();
  }

  function supabaseRequest(method, url, body = null, accessToken = null, timeout = 30000, extraHeaders = {}) {
    return new Promise((resolve, reject) => {
      const headers = {
        apikey: SUPABASE_PUBLISHABLE_KEY,
        "Content-Type": "application/json; charset=utf-8",
        ...extraHeaders
      };
      if (accessToken) headers.Authorization = `Bearer ${accessToken}`;

      GM_xmlhttpRequest({
        method,
        url,
        headers,
        data: body === null ? undefined : JSON.stringify(body),
        timeout,
        onload(response) {
          let parsed = null;
          try { parsed = response.responseText ? JSON.parse(response.responseText) : null; }
          catch (_) { parsed = null; }
          if (response.status >= 200 && response.status < 300) {
            resolve({ status: response.status, body: parsed, raw: response.responseText });
            return;
          }
          reject(new Error(parsed?.error_description || parsed?.msg || parsed?.error || parsed?.message || `Supabase HTTP ${response.status}`));
        },
        onerror() { reject(new Error("Supabase ist nicht erreichbar.")); },
        ontimeout() { reject(new Error("Zeitüberschreitung bei Supabase.")); }
      });
    });
  }

  async function signInToSupabase(email, password) {
    const result = await supabaseRequest(
      "POST",
      `${SUPABASE_URL}/auth/v1/token?grant_type=password`,
      { email, password }
    );
    if (!result.body?.access_token || !result.body?.refresh_token) {
      throw new Error("Supabase hat keine gültige Sitzung zurückgegeben.");
    }
    saveSupabaseSession(result.body);
    return result.body;
  }

  async function refreshSupabaseSession(session) {
    if (!session?.refresh_token) throw new Error("Keine Supabase-Sitzung vorhanden.");
    const result = await supabaseRequest(
      "POST",
      `${SUPABASE_URL}/auth/v1/token?grant_type=refresh_token`,
      { refresh_token: session.refresh_token }
    );
    if (!result.body?.access_token) throw new Error("Supabase-Sitzung konnte nicht erneuert werden.");
    saveSupabaseSession(result.body);
    return result.body;
  }

  function jwtExpiry(token) {
    try {
      const payload = token.split(".")[1].replace(/-/g, "+").replace(/_/g, "/");
      return Number(JSON.parse(atob(payload)).exp || 0) * 1000;
    } catch (_) { return 0; }
  }

  async function getValidSupabaseSession() {
    const session = loadSupabaseSession();
    if (!session?.access_token) throw new Error("Bitte zuerst im Companion bei Supabase anmelden.");
    if (jwtExpiry(session.access_token) > Date.now() + 60000) return session;
    return refreshSupabaseSession(session);
  }

  async function uploadSnapshotToSupabase(snapshot) {
    const session = await getValidSupabaseSession();
    const result = await supabaseRequest(
      "POST",
      SUPABASE_UPLOAD_URL,
      snapshot,
      session.access_token,
      60000
    );
    if (!result.body?.ok) throw new Error(result.body?.error || "Snapshot konnte nicht gespeichert werden.");
    return result.body;
  }

  function supabaseSessionEmail(session = loadSupabaseSession()) {
    return session?.user?.email || session?.email || null;
  }

  function updateSupabaseAuthUi(message = null, kind = "idle") {
    const session = loadSupabaseSession();
    const state = document.querySelector("#oas-supabase-state");
    const email = document.querySelector("#oas-supabase-email");
    const password = document.querySelector("#oas-supabase-password");
    const login = document.querySelector("#oas-supabase-login");
    const logout = document.querySelector("#oas-supabase-logout");
    if (state) {
      state.textContent = message || (session?.access_token ? `Angemeldet: ${supabaseSessionEmail(session) || "Benutzer"}` : "Nicht angemeldet");
      state.dataset.kind = session?.access_token && kind === "idle" ? "success" : kind;
    }
    if (email) email.hidden = Boolean(session?.access_token);
    if (password) password.hidden = Boolean(session?.access_token);
    if (login) login.hidden = Boolean(session?.access_token);
    if (logout) logout.hidden = !session?.access_token;
  }

  async function handleSupabaseLogin() {
    const email = document.querySelector("#oas-supabase-email")?.value.trim() || "";
    const password = document.querySelector("#oas-supabase-password")?.value || "";
    if (!email || !password) {
      updateSupabaseAuthUi("E-Mail und Passwort eingeben.", "error");
      return;
    }
    updateSupabaseAuthUi("Anmeldung läuft …", "running");
    try {
      await signInToSupabase(email, password);
      const field = document.querySelector("#oas-supabase-password");
      if (field) field.value = "";
      updateSupabaseAuthUi();
      transportNoteLoadRemote().catch(error =>
        console.warn("[OGame Companion] Transport-Info konnte nach Login nicht geladen werden", error)
      );
      showCollectorSnackbar("Supabase-Anmeldung erfolgreich.", "success");
    } catch (error) {
      updateSupabaseAuthUi(`Anmeldung fehlgeschlagen: ${error.message}`, "error");
    }
  }

  function handleSupabaseLogout() {
    saveSupabaseSession(null);
    updateSupabaseAuthUi();
    showCollectorSnackbar("Supabase-Sitzung entfernt.", "info");
  }

  function localDateKey(date = new Date()) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
  }


  function parseLocalizedInteger(value) {
    if (value === null || value === undefined) return null;
    const match = String(value)
      .replace(/\u00a0/g, " ")
      .match(/[-+]?\d[\d.]*/);
    if (!match) return null;
    const parsed = Number(match[0].replace(/\./g, ""));
    return Number.isFinite(parsed) ? parsed : null;
  }

  function parsePlanetTooltip(title) {
    const raw = String(title || "");
    const plain = raw
      .replace(/<br\s*\/?>/gi, "\n")
      .replace(/<[^>]+>/g, "")
      .replace(/&nbsp;/gi, " ")
      .replace(/\r/g, "")
      .trim();

    const diameterMatch = plain.match(/([\d.]+)\s*km\s*\((\d+)\s*\/\s*(\d+)\)/i);
    const temperatureMatch = plain.match(
      /([-+]?\d+)\s*°?\s*C\s*bis\s*([-+]?\d+)\s*°?\s*C/i
    );

    return {
      diameter_km: diameterMatch
        ? parseLocalizedInteger(diameterMatch[1])
        : null,
      fields_used: diameterMatch
        ? parseLocalizedInteger(diameterMatch[2])
        : null,
      fields_total: diameterMatch
        ? parseLocalizedInteger(diameterMatch[3])
        : null,
      temperature_min_c: temperatureMatch
        ? parseLocalizedInteger(temperatureMatch[1])
        : null,
      temperature_max_c: temperatureMatch
        ? parseLocalizedInteger(temperatureMatch[2])
        : null,
      raw: plain.slice(0, 500)
    };
  }

  function linkTargetsPlanet(node, planetId) {
    if (!node) return false;
    const id = String(planetId || "");
    if (!id) return false;

    const candidates = [
      node.getAttribute("data-link"),
      node.getAttribute("href"),
      node.dataset?.link
    ].filter(Boolean);

    return candidates.some(value => {
      try {
        const url = new URL(value, location.href);
        return url.searchParams.get("cp") === id;
      } catch (_) {
        return new RegExp(`(?:[?&]|&amp;)cp=${id}(?:[&#]|$)`).test(value);
      }
    });
  }

  function findPlanetLinkForId(doc, planetId) {
    const id = String(planetId || "");
    if (!id) return null;

    const container = doc.querySelector(`#planet-${CSS.escape(id)}`);
    const containedLink = container?.querySelector(".planetlink[data-tooltip-title], .planetlink[title]");

    if (containedLink && linkTargetsPlanet(containedLink, id)) {
      return containedLink;
    }

    return (
      Array.from(doc.querySelectorAll(".planetlink[data-tooltip-title], .planetlink[title]"))
        .find(node => linkTargetsPlanet(node, id)) ||
      null
    );
  }


  function parseOverviewDetails(doc, expectedPlanetId) {
    const empty = {
      diameter_km: null,
      fields_used: null,
      fields_total: null,
      temperature_min_c: null,
      temperature_max_c: null,
      source: null,
      raw: null
    };

    const returnedPlanetId = metaFromDocument(doc, "ogame-planet-id");
    if (
      returnedPlanetId &&
      String(returnedPlanetId) !== String(expectedPlanetId)
    ) {
      return {
        ...empty,
        source: "planet_id_mismatch",
        raw: `expected=${expectedPlanetId}; returned=${returnedPlanetId}`
      };
    }

    // Primärquelle: die expliziten, planetenspezifischen Overview-Felder.
    const diameterText = doc.querySelector("#diameterContentField")?.textContent?.trim() || "";
    const temperatureText = doc.querySelector("#temperatureContentField")?.textContent?.trim() || "";
    const directDiameter = diameterText.match(/([\d.]+)\s*km\s*\(\s*(\d+)\s*\/\s*(\d+)\s*\)/i);
    const directTemperature = temperatureText.match(/([-+]?\d+)\s*°?\s*C\s*(?:bis|to|-)\s*([-+]?\d+)\s*°?\s*C/i);

    if (directDiameter || directTemperature) {
      return {
        diameter_km: directDiameter ? parseLocalizedInteger(directDiameter[1]) : null,
        fields_used: directDiameter ? parseLocalizedInteger(directDiameter[2]) : null,
        fields_total: directDiameter ? parseLocalizedInteger(directDiameter[3]) : null,
        temperature_min_c: directTemperature ? parseLocalizedInteger(directTemperature[1]) : null,
        temperature_max_c: directTemperature ? parseLocalizedInteger(directTemperature[2]) : null,
        source: "overview_dom_fields",
        raw: `${diameterText} | ${temperatureText}`.slice(0, 500)
      };
    }

    // Fallback: immer den Link der erwarteten Planet-ID verwenden, niemals
    // pauschal den ersten oder aktuell markierten Planetenlink.
    const exactPlanetLink = findPlanetLinkForId(doc, expectedPlanetId);
    const exactTooltip =
      exactPlanetLink?.getAttribute("data-tooltip-title") ||
      exactPlanetLink?.dataset?.tooltipTitle ||
      exactPlanetLink?.getAttribute("title") ||
      "";
    if (exactTooltip) {
      const parsed = parsePlanetTooltip(exactTooltip);
      if (parsed.fields_total !== null || parsed.temperature_min_c !== null) {
        return { ...parsed, source: "planet_sidebar_tooltip_exact_id" };
      }
    }

    const roots = [
      doc.querySelector("#planetdata"),
      doc.querySelector("#overviewcomponent #planetdata"),
      doc.querySelector("#overviewcomponent .planetData"),
      doc.querySelector("[data-component='overview'] #planetdata"),
      doc.querySelector(".planetData")
    ].filter(Boolean);

    const candidates = [];

    for (const root of roots) {
      const ownTitle = root.getAttribute?.("title");
      if (ownTitle) candidates.push(ownTitle);

      for (const node of root.querySelectorAll("[title]")) {
        if (
          node.closest("#planetList, #myPlanets, .smallplanet, .planetlink")
        ) {
          continue;
        }
        const title = node.getAttribute("title");
        if (title) candidates.push(title);
      }

      const visibleText = String(root.innerText || root.textContent || "")
        .replace(/\u00a0/g, " ")
        .replace(/\s+/g, " ")
        .trim();
      if (visibleText) candidates.push(visibleText);
    }

    for (const candidate of candidates) {
      const parsed = parsePlanetTooltip(candidate);
      if (
        parsed.fields_total !== null ||
        parsed.temperature_min_c !== null
      ) {
        return {
          ...parsed,
          source: "current_planet_overview"
        };
      }

      const plain = String(candidate)
        .replace(/<br\s*\/?>/gi, " ")
        .replace(/<[^>]+>/g, " ")
        .replace(/&nbsp;/gi, " ")
        .replace(/\s+/g, " ")
        .trim();

      const fields = plain.match(
        /(?:Felder|Fields?)\s*:?\s*(\d+)\s*\/\s*(\d+)/i
      );
      const diameter = plain.match(
        /(?:Durchmesser|Diameter)\s*:?\s*([\d.]+)\s*km/i
      );
      const temperature = plain.match(
        /(?:Temperatur|Temperature)\s*:?\s*([-+]?\d+)\s*°?\s*C?\s*(?:bis|to|-)\s*([-+]?\d+)\s*°?\s*C/i
      );

      if (fields || diameter || temperature) {
        return {
          diameter_km: diameter ? parseLocalizedInteger(diameter[1]) : null,
          fields_used: fields ? parseLocalizedInteger(fields[1]) : null,
          fields_total: fields ? parseLocalizedInteger(fields[2]) : null,
          temperature_min_c: temperature ? parseLocalizedInteger(temperature[1]) : null,
          temperature_max_c: temperature ? parseLocalizedInteger(temperature[2]) : null,
          source: "current_planet_overview_text",
          raw: plain.slice(0, 1000)
        };
      }
    }

    return empty;
  }

  function collectActiveFlights(doc = document) {
    const ownCoordinates = new Set(
      Array.from(doc.querySelectorAll("#planetList .planet-koords, #myPlanets .planet-koords, .smallplanet .planet-koords"))
        .map(node => String(node.textContent || "").replace(/[\[\]]/g, "").trim())
        .filter(Boolean)
    );
    const nodes = Array.from(doc.querySelectorAll(
      "#eventList .eventFleet, #eventList li[id^='eventRow'], #eventListWrap .eventFleet, #eventListWrap li[id^='eventRow'], .eventFleet"
    ));
    const flights = [];
    const seen = new Set();
    for (const node of nodes) {
      const classText = `${node.className || ""} ${node.getAttribute?.("data-owner") || ""}`.toLocaleLowerCase("de-DE");
      if (/hostile|feindlich|neutral|foreign|fremd/.test(classText)) continue;
      const tooltipNodes = Array.from(node.querySelectorAll("[data-tooltip-title], [title]"));
      const rawTitles = tooltipNodes.map(item => item.getAttribute("data-tooltip-title") || item.getAttribute("title") || "").filter(Boolean);
      const rawTitle = [node.getAttribute?.("data-tooltip-title") || "", node.getAttribute?.("title") || "", ...rawTitles].join(" ");
      const plain = String(rawTitle).replace(/<br\s*\/?>/gi, " ").replace(/<[^>]+>/g, " ").replace(/&nbsp;/gi, " ").replace(/\s+/g, " ").trim();
      const text = String(node.innerText || node.textContent || "").replace(/\s+/g, " ").trim();
      const combined = `${text} ${plain}`.trim();
      const id = node.dataset?.missionId || node.dataset?.eventId || node.dataset?.fleetId || node.id || combined.slice(0, 300);
      if (!id || seen.has(id)) continue;
      const coords = Array.from(combined.matchAll(/\[(\d+:\d+:\d+)\]/g)).map(match => match[1]);
      const origin = coords[0] || null;
      const looksOwned = /friendly|own|rückkehr|return|partner/i.test(classText) || (origin && ownCoordinates.has(origin));
      if (ownCoordinates.size && !looksOwned) continue;
      seen.add(id);

      const ships = {};
      let match;
      const shipRx = /(?:Anzahl|Schiffe?|Ships?)?\s*([A-Za-zÄÖÜäöüß][A-Za-zÄÖÜäöüß \-]+?)\s*:?\s*([\d.]+)/gi;
      while ((match = shipRx.exec(plain))) {
        const name = match[1].trim();
        const value = parseLocalizedInteger(match[2]);
        if (value !== null && !/zeit|ankunft|rückkehr|koordinaten|spieler|mission|flotte|gesamt/i.test(name)) ships[name] = value;
      }

      const explicitCountNodes = [
        node.querySelector(".fleetDetails .value"), node.querySelector(".fleetDetail .value"),
        node.querySelector(".shipCount"), node.querySelector(".ships"), node.querySelector("[data-ship-count]")
      ].filter(Boolean);
      let shipCount = null;
      for (const countNode of explicitCountNodes) {
        const candidate = countNode.getAttribute?.("data-ship-count") || countNode.textContent;
        const parsed = parseLocalizedInteger(candidate);
        if (parsed !== null) { shipCount = parsed; break; }
      }
      if (shipCount === null) {
        const afterOrigin = origin ? combined.split(`[${origin}]`).slice(1).join(" ") : combined;
        const beforeDestination = coords[1] ? afterOrigin.split(`[${coords[1]}]`)[0] : afterOrigin;
        const candidates = Array.from(beforeDestination.matchAll(/(?:^|\s)([\d.]+)(?=\s|$)/g), item => parseLocalizedInteger(item[1])).filter(value => value !== null);
        shipCount = candidates.length ? candidates[0] : null;
      }
      if (shipCount === null && Object.keys(ships).length) shipCount = Object.values(ships).reduce((sum, value) => sum + value, 0);

      flights.push({
        id: String(id),
        mission: node.querySelector(".mission,.missionType")?.textContent?.trim() || node.getAttribute("data-mission-type") || node.dataset?.missionType || text.match(/Expedition|Transport|Stationieren|Angriff|Spionage|Kolonisieren|Abbau|Halten|Zerstören/i)?.[0] || null,
        origin_coordinates: origin,
        destination_coordinates: coords[1] || coords[0] || null,
        arrival: node.querySelector(".arrivalTime,.countdown,time")?.getAttribute("datetime") || node.querySelector(".arrivalTime,.countdown,time")?.textContent?.trim() || node.dataset?.arrival || null,
        returning: /rückkehr|return/i.test(`${classText} ${combined}`),
        ships,
        ship_count: shipCount,
        raw: combined.slice(0, 1500)
      });
    }
    return flights;
  }

  function parseResourceTooltip(doc, resource) {
    const box = doc.querySelector(`#${resource}_box`);
    const title = box?.getAttribute("title") || "";

    const productionMatch = title.match(
      /Aktuelle Produktion:<\/th><td><span[^>]*>\s*([+-]?[\d.]+)\s*<\/span>/i
    );
    const storageMatch = title.match(
      /Lagerkapazität<\/th><td><span[^>]*>\s*([\d.]+)\s*<\/span>/i
    );
    const currentNode = doc.querySelector(`#resources_${resource}`);
    const currentRaw =
      currentNode?.getAttribute("data-raw") ||
      currentNode?.textContent ||
      null;

    return {
      current: parseLocalizedInteger(currentRaw),
      storage: storageMatch
        ? parseLocalizedInteger(storageMatch[1])
        : null,
      per_hour: productionMatch
        ? parseLocalizedInteger(productionMatch[1])
        : null,
      source: title ? `#${resource}_box[title]` : null
    };
  }

  async function fetchBackgroundComponent(body, component) {
    const requestedUrl = buildBackgroundUrl(body, component.id);
    const started = performance.now();

    const response = await fetch(requestedUrl, {
      method: "GET",
      credentials: "include",
      cache: "no-store",
      redirect: "follow",
      headers: {
        "Accept": "text/html,application/xhtml+xml"
      }
    });

    const html = await response.text();
    const doc = new DOMParser().parseFromString(html, "text/html");
    const middle = doc.querySelector("#middle");
    const middleText = normalizeBackgroundText(middle?.innerText || middle?.textContent);
    const returnedPlanetId = metaFromDocument(doc, "ogame-planet-id");
    const returnedPlanetName = metaFromDocument(doc, "ogame-planet-name");
    const returnedCoordinates = metaFromDocument(doc, "ogame-planet-coordinates");
    const returnedComponent =
      new URL(response.url || requestedUrl, location.href)
        .searchParams.get("component") ||
      "";

    const matchedHints = component.hints.filter(hint =>
      middleText.toLocaleLowerCase("de-DE")
        .includes(hint.toLocaleLowerCase("de-DE"))
    );

    // OGame rendert viele Technikseiten über strukturierte Elemente, deren
    // sichtbarer Text nicht zuverlässig in #middle.innerText auftaucht.
    const technologyNodes = Array.from(doc.querySelectorAll(
      "[data-technology], [data-technology-id], " +
      ".technology, .building, .research, .shipyard, .defense"
    ));

    const parsedTechnologies = [];
    const seenTechnologyKeys = new Set();

    for (const node of technologyNodes) {
      const technologyId =
        node.getAttribute("data-technology") ||
        node.getAttribute("data-technology-id") ||
        node.dataset?.technology ||
        node.dataset?.technologyId ||
        "";

      const name =
        node.querySelector(
          ".technology-name, .name, .building-name, .research-name, " +
          ".ship-name, .defense-name, h2, h3"
        )?.textContent?.trim() ||
        node.getAttribute("title")?.trim() ||
        "";

      const levelText =
        node.querySelector(
          ".level, .amount, .technology-level, .building-level, " +
          ".research-level, .ship-amount, .defense-amount"
        )?.textContent ||
        node.getAttribute("data-level") ||
        node.getAttribute("data-amount") ||
        "";

      const levelMatch = String(levelText).match(/-?\d[\d.]*/);
      const level = levelMatch
        ? Number(levelMatch[0].replace(/\./g, ""))
        : null;

      const key = `${technologyId}|${name}|${level}`;
      if ((technologyId || name) && !seenTechnologyKeys.has(key)) {
        seenTechnologyKeys.add(key);
        parsedTechnologies.push({
          id: technologyId || null,
          name: name || null,
          level
        });
      }
    }

    const componentMarkers = {
      overview: [
        "#overviewcomponent", ".overview", "#planetdata",
        "[data-component='overview']"
      ],
      resourcesettings: [
        "#resourcesettings", ".resourceSettings", ".resourceSettingsForm",
        "[data-component='resourcesettings']",
        "[data-page='resourcesettings']"
      ],
      supplies: [
        "#supplies", ".supplies", "#productionbox",
        "[data-component='supplies']",
        "[data-page='supplies']"
      ],
      facilities: [
        "#facilities", ".facilities",
        "[data-component='facilities']",
        "[data-page='facilities']"
      ],
      research: [
        "#research", ".research",
        "[data-component='research']",
        "[data-page='research']"
      ],
      shipyard: [
        "#shipyard", ".shipyard",
        "[data-component='shipyard']",
        "[data-page='shipyard']"
      ],
      defenses: [
        "#defense", "#defenses", ".defense", ".defenses",
        "[data-component='defenses']",
        "[data-page='defenses']"
      ]
    };

    const matchedSelectors = (componentMarkers[component.id] || [])
      .filter(selector => {
        try {
          return Boolean(doc.querySelector(selector));
        } catch (_) {
          return false;
        }
      });

    const overviewFacts = {};
    const overviewFactSources = {};
    let productionData = null;

    if (component.id === "overview") {
      const directOverview = parseOverviewDetails(doc, body.id);
      Object.assign(overviewFacts, {
        diameter: directOverview.diameter_km,
        fields_used: directOverview.fields_used,
        fields_total: directOverview.fields_total,
        temperature_min: directOverview.temperature_min_c,
        temperature_max: directOverview.temperature_max_c
      });

      overviewFactSources.planet = directOverview.source;
      overviewFactSources.tooltip_preview = directOverview.raw;

      const metal = parseResourceTooltip(doc, "metal");
      const crystal = parseResourceTooltip(doc, "crystal");
      const deuterium = parseResourceTooltip(doc, "deuterium");
      const energy = parseResourceTooltip(doc, "energy");

      // Overview liefert nur Bestände und Lager. Produktion wird bewusst
      // nicht hier übernommen, damit ausschließlich OGames effektive Werte
      // aus component=resourcesettings maßgeblich sind.
      productionData = {
        energy_available: energy.current,
        metal_current: metal.current,
        crystal_current: crystal.current,
        deuterium_current: deuterium.current,
        metal_storage: metal.storage,
        crystal_storage: crystal.storage,
        deuterium_storage: deuterium.storage,
        source: "overview_current_and_storage"
      };
    }

    if (component.id === "resourcesettings") {
      const metal = parseResourceTooltip(doc, "metal");
      const crystal = parseResourceTooltip(doc, "crystal");
      const deuterium = parseResourceTooltip(doc, "deuterium");
      const energy = parseResourceTooltip(doc, "energy");

      productionData = {
        metal_per_hour: metal.per_hour,
        crystal_per_hour: crystal.per_hour,
        deuterium_per_hour: deuterium.per_hour,
        energy_available: energy.current,
        energy_production: energy.per_hour,
        metal_current: metal.current,
        crystal_current: crystal.current,
        deuterium_current: deuterium.current,
        metal_storage: metal.storage,
        crystal_storage: crystal.storage,
        deuterium_storage: deuterium.storage,
        source: "resourcesettings_effective_resource_tooltips"
      };

    }

    const errors = [];
    if (!response.ok) errors.push(`HTTP ${response.status}`);
    if (!middle) errors.push("#middle fehlt");
    if (html.length < 2000) errors.push(`Antwort auffällig klein (${html.length})`);
    if (returnedPlanetId && String(returnedPlanetId) !== String(body.id)) {
      errors.push(`falscher Planet zurückgegeben: ${returnedPlanetId}`);
    }
    if (returnedComponent && returnedComponent !== component.id) {
      errors.push(`umgeleitet zu Komponente ${returnedComponent}`);
    }
    if (/login|lobby/i.test(response.url || "")) {
      errors.push("zur Anmeldung/Lobby umgeleitet");
    }

    // Ein Abruf gilt als technisch erfolgreich, wenn HTTP, Planet und
    // Komponente stimmen. Fehlende Hinweise sind nur Parser-Diagnose.
    const parserWarnings = [];
    if (
      !matchedHints.length &&
      !matchedSelectors.length &&
      !parsedTechnologies.length
    ) {
      parserWarnings.push(
        "Noch keine verwertbaren Technikmarker erkannt; HTML-Struktur ergänzen."
      );
    }

    return {
      component: component.id,
      label: component.label,
      requested_url: requestedUrl,
      final_url: response.url || requestedUrl,
      status: response.status,
      ok: errors.length === 0,
      parser_ok:
        matchedHints.length > 0 ||
        matchedSelectors.length > 0 ||
        parsedTechnologies.length > 0 ||
        Boolean(productionData),
      duration_ms: Math.round(performance.now() - started),
      bytes: html.length,
      returned_planet_id: returnedPlanetId || null,
      returned_planet_name: returnedPlanetName || null,
      returned_coordinates: returnedCoordinates || null,
      matched_hints: matchedHints,
      matched_selectors: matchedSelectors,
      technology_count: parsedTechnologies.length,
      technologies: parsedTechnologies.slice(0, 40),
      parser_warnings: parserWarnings,
      errors,
      sample: middleText.slice(0, 420),
      full_middle_text: middleText.slice(0, 20000),
      overview_facts: overviewFacts,
      overview_fact_sources: overviewFactSources,
      production_data: productionData
    };
  }

  function updateBackgroundCollectorUi(result = loadBackgroundTest()) {
    const status = document.querySelector("#oas-bg-status");
    const log = document.querySelector("#oas-bg-log");
    const retry = document.querySelector("#oas-bg-copy");
    if (!status || !log) return;

    if (!result) {
      status.textContent = "Noch kein Test ausgeführt.";
      status.dataset.kind = "idle";
      log.value = "";
      if (retry) retry.disabled = true;
      return;
    }

    const requests = result.bodies
      .flatMap(body => body.results || []);
    const successes = requests.filter(item => item.ok).length;
    const failures = requests.length - successes;
    const parserReady = requests.filter(item => item.parser_ok).length;

    status.textContent =
      `${result.bodies.length} Objekte · ${successes}/${requests.length} Abrufe erfolgreich` +
      ` · Parser ${parserReady}/${requests.length}` +
      (failures ? ` · ${failures} technische Fehler` : "");
    status.dataset.kind = failures ? "error" : "success";
    if (retry) retry.disabled = false;

    const lines = [
      "OGame Background Collector/Parser Test 6.2.0",
      "====================================",
      `Spieler: ${result.player_name || "unbekannt"} (${result.player_id || "?"})`,
      `Universum: ${result.universe || "unbekannt"}`,
      `Start: ${result.started_at}`,
      `Ende: ${result.finished_at || "läuft"}`,
      `Status: ${result.status}`,
      `Sichtbare Seite unverändert: ${location.href}`,
      ""
    ];

    for (const body of result.bodies) {
      lines.push(
        `${body.type === "moon" ? "Mond" : "Planet"}: ${body.name}`,
        `ID: ${body.id} · Koordinaten: ${body.coordinates || "?"}`,
        "------------------------------------"
      );

      for (const item of body.results || []) {
        lines.push(
          `${item.ok ? "OK " : "FEHLER"} ${item.label} (${item.component})`,
          `  HTTP: ${item.status} · ${item.bytes} Bytes · ${item.duration_ms} ms`,
          `  Antwortplanet: ${item.returned_planet_name || "?"} ` +
            `(${item.returned_planet_id || "?"}) ${item.returned_coordinates || ""}`,
          `  Texthinweise: ${item.matched_hints?.join(", ") || "keine"}`,
          `  DOM-Marker: ${item.matched_selectors?.join(", ") || "keine"}`,
          `  Technikobjekte: ${item.technology_count || 0}`,
          `  Parser: ${item.parser_ok ? "verwertbare Struktur erkannt" : "noch offen"}`
        );
        if (item.component === "overview" || item.component === "resourcesettings") {
          lines.push(
            `  Planetendaten: ${JSON.stringify(item.overview_facts || {})}`
          );
          lines.push(
            `  Produktion: ${JSON.stringify(item.production_data || {})}`
          );
          lines.push(
            `  Quellen: ${JSON.stringify(item.overview_fact_sources || {})}`
          );
        }

        if (item.technologies?.length) {
          item.technologies.slice(0, 15).forEach(technology => {
            lines.push(
              `    Technik ${technology.id || "?"}: ` +
              `${technology.name || "(Name fehlt)"} = ` +
              `${technology.level ?? "(Stufe fehlt)"}`
            );
          });
        }
        if (item.parser_warnings?.length) {
          item.parser_warnings.forEach(warning =>
            lines.push(`  Parser-Hinweis: ${warning}`)
          );
        }
        if (item.errors?.length) {
          item.errors.forEach(error => lines.push(`  Problem: ${error}`));
        }
        lines.push(`  Textprobe: ${item.sample || "(leer)"}`, "");
      }
    }

    if (result.general_errors?.length) {
      lines.push("Allgemeine Fehler", "----------------");
      result.general_errors.forEach(error => lines.push(error));
    }

    log.value = lines.join("\n");
  }

  function showCollectorSnackbar(text, kind = "info", actions = []) {
    let bar = document.querySelector("#oas-snackbar");
    if (!bar) {
      bar = document.createElement("div");
      bar.id = "oas-snackbar";
      document.body.appendChild(bar);
    }

    bar.dataset.kind = kind;
    bar.innerHTML = "";

    const message = document.createElement("span");
    message.textContent = text;
    bar.appendChild(message);

    for (const action of actions) {
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = action.label;
      button.addEventListener("click", action.run, { once: true });
      bar.appendChild(button);
    }

    bar.classList.add("oas-visible");
    window.clearTimeout(showCollectorSnackbar.timer);
    showCollectorSnackbar.timer = window.setTimeout(
      () => bar.classList.remove("oas-visible"),
      actions.length ? 15000 : 7000
    );
  }



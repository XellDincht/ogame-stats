    {id:"rocket_launcher",cat:"defense",name:"Raketenwerfer",icon:"🚀",kind:"count",cost:[2000,0,0]},
    {id:"light_laser",cat:"defense",name:"Leichtes Lasergeschütz",icon:"🔴",kind:"count",cost:[1500,500,0]},
    {id:"heavy_laser",cat:"defense",name:"Schweres Lasergeschütz",icon:"🔴",kind:"count",cost:[6000,2000,0]},

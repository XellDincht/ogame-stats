  function extractBalancedJson(source, objectStart) {
    let depth = 0;
    let inString = false;
    let escaped = false;
    for (let index = objectStart; index < source.length; index += 1) {
      const char = source[index];
      if (inString) {
        if (escaped) escaped = false;
        else if (char === "\\") escaped = true;
        else if (char === '"') inString = false;
        continue;
      }
      if (char === '"') inString = true;
      else if (char === "{") depth += 1;
      else if (char === "}") {
        depth -= 1;
        if (depth === 0) return source.slice(objectStart, index + 1);
      }
    }
    throw new Error("Empire-Datenobjekt ist unvollständig.");
  }

  function extractEmpirePayload(html) {
    const callIndex = html.indexOf("createImperiumHtml");
    if (callIndex < 0) throw new Error("createImperiumHtml wurde nicht gefunden.");
    const objectStart = html.indexOf("{", callIndex);
    if (objectStart < 0) throw new Error("Empire-JSON wurde nicht gefunden.");
    return JSON.parse(extractBalancedJson(html, objectStart));
  }

  function empireInteger(value) {
    if (typeof value === "number" && Number.isFinite(value)) return Math.trunc(value);
    const match = String(value ?? "").replace(/\u00a0/g, " ").match(/[-+]?\d[\d.]*/);
    return match ? Number(match[0].replace(/\./g, "")) : null;
  }

  function empireTemperature(value) {
    const numbers = Array.from(String(value || "").matchAll(/-?\d+/g), match => Number(match[0]));
    return { min: numbers[0] ?? null, max: numbers[1] ?? numbers[0] ?? null };
  }

  function empireTechnologies(planet, ids, translations) {
    const names = translations?.planets || {};
    return (ids || []).map(rawId => {
      const id = String(rawId);
      const translatedName = names[`${id}_full`] || names[id];
      return { id, name: translatedName || EMPIRE_TECH_NAMES[id] || `Technologie ${id}`, value: empireInteger(planet[id]) ?? 0, level: empireInteger(planet[id]) ?? 0, amount: empireInteger(planet[id]) ?? 0 };
    });
  }

  function empireGroupIds(groups, aliases, fallbackRange, planet) {
    const found = [];
    for (const [key, value] of Object.entries(groups || {})) {
      if (!aliases.some(alias => key.toLocaleLowerCase("de-DE").includes(alias))) continue;
      const values = Array.isArray(value) ? value : Object.values(value || {});
      for (const item of values) {
        const id = typeof item === "object" ? (item.id ?? item.technologyId ?? item.technology_id) : item;
        if (id !== undefined && id !== null) found.push(String(id));
      }
    }
    if (!found.length && fallbackRange) {
      for (const key of Object.keys(planet || {})) {
        const numeric = Number(key);
        if (Number.isInteger(numeric) && numeric >= fallbackRange[0] && numeric <= fallbackRange[1]) found.push(String(key));
      }
    }
    return [...new Set(found)].sort((a, b) => Number(a) - Number(b));
  }

  function empireLifeformName(planet) {
    const raw = planet.lifeformName ?? planet.lifeform ?? planet.lifeformType ?? planet.lifeform_id ?? planet.lifeformId;
    const names = { "1": "Menschen", "2": "Rock'tal", "3": "Mechas", "4": "Kaelesh" };
    return names[String(raw)] || (typeof raw === "string" && !/^\d+$/.test(raw) ? raw : null);
  }


  function empireLifeformTechnologyIds(planet, kind) {
    const pattern = kind === "building" ? /^1[1-4]1\d{2}$/ : /^1[1-4]2\d{2}$/;
    return Object.keys(planet || {})
      .filter(key => pattern.test(String(key)))
      .sort((a, b) => Number(a) - Number(b));
  }

  function readAccountClassContext() {
    const page = getPageWindow();
    const sources = [
      page?.playerClass,
      page?.ogame?.playerClass,
      page?.serverData?.playerClass,
      document.body?.dataset?.playerClass,
      metaFromDocument(document, "ogame-player-class")
    ];
    const raw = sources.find(value => value !== undefined && value !== null && String(value).trim() !== "");
    const normalized = String(raw ?? "").toLocaleLowerCase("de-DE");
    if (/collector|kollektor|1/.test(normalized)) return { id: 1, name: "Kollektor", detected: true };
    if (/general|generalin|2/.test(normalized)) return { id: 2, name: "General", detected: true };
    if (/discoverer|entdecker|3/.test(normalized)) return { id: 3, name: "Entdecker", detected: true };
    return { id: null, name: null, detected: false };
  }

  function readOfficerContext() {
    const definitions = [
      ["commander", "Commander"], ["admiral", "Admiral"], ["engineer", "Ingenieur"],
      ["geologist", "Geologe"], ["technocrat", "Technokrat"], ["commandingStaff", "Kommandostab"]
    ];
    const result = {};
    for (const [key, label] of definitions) {
      const node = document.querySelector(`#${key}, .${key}, [data-officer='${key}'], [data-officer-name='${key}']`);
      if (!node) { result[key] = { label, active: null, detected: false }; continue; }
      const source = `${node.className || ""} ${node.getAttribute?.("title") || ""} ${node.textContent || ""}`.toLocaleLowerCase("de-DE");
      const inactive = /inactive|inaktiv|nicht aktiv|abgelaufen|off/.test(source);
      const active = !inactive && (/active|aktiv|on|remaining|restzeit/.test(source) || node.classList?.contains("active"));
      result[key] = { label, active: active ? true : inactive ? false : null, detected: true };
    }
    return result;
  }

  function readBoosterContext() {
    const candidates = Array.from(document.querySelectorAll("[class*='booster'], [id*='booster'], [data-item], [data-bonus]"));
    const seen = new Set();
    const boosters = [];
    for (const node of candidates) {
      const text = `${node.getAttribute?.("title") || ""} ${node.getAttribute?.("data-tooltip-title") || ""} ${node.textContent || ""}`.replace(/\s+/g, " ").trim();
      if (!text || !/(metall|kristall|deut|energie|produktion|booster|item)/i.test(text)) continue;
      const key = text.toLocaleLowerCase("de-DE");
      if (seen.has(key)) continue;
      seen.add(key);
      const percent = text.match(/([+]?[0-9]+(?:[.,][0-9]+)?)\s*%/);
      boosters.push({ text: text.slice(0, 240), percent: percent ? Number(percent[1].replace(",", ".")) : null });
    }
    return boosters.slice(0, 50);
  }

  function readAccountContext() {
    return {
      class: readAccountClassContext(),
      officers: readOfficerContext(),
      boosters: readBoosterContext(),
      detected_at: new Date().toISOString(),
      source: "current_document"
    };
  }

  function empirePlanetToSnapshot(planet, groups, translations, order) {
    const temperature = empireTemperature(planet.temperature);
    const hourly = planet.production?.hourly || {};
    const energyTooltip = String(planet.energyTooltip || "");
    const energyValues = Array.from(energyTooltip.matchAll(/[+-]?\d[\d.]*/g), match => empireInteger(match[0]));
    const coordinates = String(planet.coordinates || `${planet.galaxy}:${planet.system}:${planet.position}`).replace(/[\[\]]/g, "");
    return {
      id: Number(planet.id), name: String(planet.name || `Planet ${planet.id}`), coordinates,
      type: Number(planet.type) === 3 ? "moon" : "planet", order,
      image_url: planet.image || null, background_image_url: planet.backgroundImage || null,
      overview: {
        diameter_km: empireInteger(planet.db_par1 ?? planet.diameter), fields_used: empireInteger(planet.fieldUsed), fields_total: empireInteger(planet.fieldMax),
        temperature_min_c: temperature.min, temperature_max_c: temperature.max,
        raw_hints: { source: "empire_createImperiumHtml", diameter: planet.diameter, temperature: planet.temperature }
      },
      production: {
        metal_per_hour: empireInteger(hourly[0] ?? hourly["0"]), crystal_per_hour: empireInteger(hourly[1] ?? hourly["1"]), deuterium_per_hour: empireInteger(hourly[2] ?? hourly["2"]),
        energy_available: empireInteger(hourly[3] ?? hourly["3"] ?? planet.energy), energy_production: energyValues.at(-1) ?? null,
        metal_current: empireInteger(planet.metal), crystal_current: empireInteger(planet.crystal), deuterium_current: empireInteger(planet.deuterium),
        metal_storage: empireInteger(planet.metalStorage), crystal_storage: empireInteger(planet.crystalStorage), deuterium_storage: empireInteger(planet.deuteriumStorage),
        source: "empire_createImperiumHtml.production.hourly"
      },
      // Use the exact Empire groups. Broad substring matching (for example "research")
      // also catches lifeform research groups and mixes them into the normal sections.
      buildings: empireTechnologies(planet, groups.supply || empireGroupIds(groups, ["supply"], [1, 99], planet), translations),
      facilities: empireTechnologies(planet, groups.station || empireGroupIds(groups, ["station"], null, planet), translations),
      research: empireTechnologies(planet, groups.research || empireGroupIds(groups, ["research"], [100, 199], planet).filter(id => Number(id) < 10000), translations),
      ships: empireTechnologies(planet, groups.ships || empireGroupIds(groups, ["ships"], [200, 399], planet), translations),
      defenses: empireTechnologies(planet, groups.defence || groups.defense || empireGroupIds(groups, ["defence", "defense"], [400, 599], planet), translations),
      lifeform_name: empireLifeformName(planet),
      lifeform_buildings: empireTechnologies(planet, empireLifeformTechnologyIds(planet, "building"), translations),
      lifeform_research: empireTechnologies(planet, empireLifeformTechnologyIds(planet, "research"), translations),
      modules: { empire: { ok: true, parser_ok: true, status: 200, technology_count: [...(groups.supply||[]),...(groups.station||[]),...(groups.research||[]),...(groups.ships||[]),...(groups.defence||[])].length, warnings: [], errors: [] } },
      complete: true, missing: []
    };
  }

  async function collectMoonSnapshots() {
    const moons = discoverOwnCelestialBodies().filter(body => body.type === "moon");
    const collected = [];

    for (const moon of moons) {
      const results = [];
      for (const component of MOON_BACKGROUND_COMPONENTS) {
        try {
          results.push(await fetchBackgroundComponent(moon, component));
        } catch (error) {
          results.push({
            component: component.id,
            label: component.label,
            status: 0,
            ok: false,
            parser_ok: false,
            duration_ms: null,
            bytes: 0,
            returned_planet_id: null,
            returned_planet_name: null,
            returned_coordinates: null,
            matched_hints: [],
            matched_selectors: [],
            technology_count: 0,
            technologies: [],
            parser_warnings: [],
            errors: [error.message || String(error)],
            sample: "",
            overview_facts: {},
            overview_fact_sources: {},
            production_data: null
          });
        }
      }

      const snapshotMoon = moduleResultToSnapshotPlanet({
        ...moon,
        results
      });

      // Fehlende, auf Monden absichtlich nicht abgefragte Komponenten
      // dürfen den Gesamt-Snapshot nicht unvollständig machen.
      snapshotMoon.complete = results.every(result => result.ok);
      snapshotMoon.missing = results.filter(result => !result.ok).map(result => result.component);
      collected.push({
        body: moon,
        snapshot: snapshotMoon,
        results
      });
    }

    return collected;
  }

  async function collectEmpireSnapshot() {
    const startedAt = new Date().toISOString();
    const url = new URL(location.href);
    url.searchParams.set("page", "standalone"); url.searchParams.set("component", "empire"); url.searchParams.delete("cp"); url.hash = "";
    const response = await fetch(url.toString(), { credentials: "include", cache: "no-store", headers: { Accept: "text/html,application/xhtml+xml" } });
    const html = await response.text();
    if (!response.ok) throw new Error(`Empire-Abruf HTTP ${response.status}`);
    const payload = extractEmpirePayload(html);
    if (!Array.isArray(payload.planets) || !payload.planets.length) throw new Error("Empire-Ansicht enthält keine Planeten.");
    const groups = payload.groups || {};
    const finishedAt = new Date().toISOString();
    const planets = payload.planets.map((planet, order) => empirePlanetToSnapshot(planet, groups, payload.translations || {}, order));
    const moonCollections = await collectMoonSnapshots();
    const moons = moonCollections.map(entry => entry.snapshot);
    const celestialBodies = [...planets, ...moons];

    const research = new Map();
    planets.forEach(planet => planet.research.forEach(tech => { const old = research.get(tech.id); if (!old || tech.value > old.value) research.set(tech.id, tech); }));
    const snapshot = {
      format: "ogame-account-snapshot-v1", schema_version: 1, collector_version: "7.16.0",
      snapshot_id: `${metaFromDocument(document,"ogame-universe") || location.host}:${metaFromDocument(document,"ogame-player-id") || "unknown"}:${finishedAt}`,
      created_at: finishedAt, collection_started_at: startedAt, collection_finished_at: finishedAt,
      player: { id: metaFromDocument(document,"ogame-player-id") || null, name: metaFromDocument(document,"ogame-player-name") || null },
      universe: metaFromDocument(document,"ogame-universe") || location.host, complete: true, upload_status: "LOCAL_ONLY", uploaded_at: null,
      account: {
        research: Array.from(research.values()).sort((a,b)=>Number(a.id)-Number(b.id)),
        active_flights: collectActiveFlights(document),
        context: readAccountContext()
      }, planets: celestialBodies,
      summary: {
        planet_count: planets.length,
        moon_count: moons.length,
        active_flight_count: collectActiveFlights(document).length,
        module_count: planets.length + moonCollections.reduce((sum, entry) => sum + entry.results.length, 0),
        technology_records: celestialBodies.reduce((sum,p)=>sum+p.buildings.length+p.facilities.length+p.research.length+p.ships.length+p.defenses.length+(p.lifeform_buildings?.length||0)+(p.lifeform_research?.length||0),0),
        missing_modules: moonCollections.flatMap(entry => entry.snapshot.missing.map(component => ({
          planet_id: entry.snapshot.id,
          planet_name: entry.snapshot.name,
          coordinates: entry.snapshot.coordinates,
          component
        }))),
        parser_open_modules: [],
        source: "empire_plus_moons"
      }
    };

    const planetDiagnostics = planets.map(p => ({
      id:p.id,name:p.name,coordinates:p.coordinates,type:p.type,
      results:[{
        component:"empire",label:"Imperiumsansicht",ok:true,parser_ok:true,
        status:response.status,bytes:html.length,
        technology_count:p.modules.empire.technology_count,
        errors:[],parser_warnings:[],sample:`${p.name} ${p.coordinates}`
      }]
    }));
    const moonDiagnostics = moonCollections.map(entry => ({
      id: entry.snapshot.id,
      name: entry.snapshot.name,
      coordinates: entry.snapshot.coordinates,
      type: "moon",
      results: entry.results
    }));

    return {
      snapshot,
      diagnostics: {
        format:"ogame-empire-collector-v1",
        version:"7.16.0",
        started_at:startedAt,
        finished_at:finishedAt,
        status: snapshot.summary.missing_modules.length ? "INCOMPLETE" : "COMPLETE",
        player_id:snapshot.player.id,
        player_name:snapshot.player.name,
        universe:snapshot.universe,
        bodies:[...planetDiagnostics, ...moonDiagnostics],
        general_errors:[]
      }
    };
  }

  function setCleanSnapshotProgress(step, detailText) {
    const progress = document.querySelector("#oas-snapshot-progress");
    const detail = document.querySelector("#oas-snapshot-detail");
    if (progress) { progress.max = 3; progress.value = Math.max(0, Math.min(3, Number(step) || 0)); }
    if (detail && detailText) detail.textContent = `${Math.max(0, Math.min(3, Number(step) || 0))}/3 Schritte · ${detailText}`;
  }

  async function runBackgroundCollectorTest() {
    if (backgroundCollectorRunning) return;
    const startButton = document.querySelector("#oas-bg-start");
    const visibleStartButton = document.querySelector("#oas-player-snapshot");
    const progressText = document.querySelector("#oas-bg-progress");
    backgroundCollectorRunning = true;
    if (startButton) startButton.disabled = true;
    if (visibleStartButton) visibleStartButton.disabled = true;
    try {
      setCleanSnapshotProgress(0, "Imperiumsansicht wird geladen …");
      if (progressText) progressText.textContent = "Imperiumsansicht wird geladen …";
      const { snapshot, diagnostics } = await collectEmpireSnapshot();
      setCleanSnapshotProgress(1, "Empire-Daten empfangen");
      saveBackgroundTest(diagnostics);
      setCleanSnapshotProgress(2, "Spieler-Snapshot erstellt");
      let finalUploadDetail = "Supabase-Upload noch nicht abgeschlossen";
      try {
        const upload = await uploadSnapshotToSupabase(snapshot);
        snapshot.upload_status = upload.status === "already_exists" ? "ALREADY_STORED" : "STORED_IN_SUPABASE";
        snapshot.uploaded_at = new Date().toISOString();
        finalUploadDetail = upload.status === "already_exists"
          ? "Snapshot war bereits in Supabase gespeichert"
          : `In Supabase gespeichert · ${upload.objects || 0} Objekte · ${upload.technologies || 0} Werte`;
      } catch (uploadError) {
        snapshot.upload_status = "LOCAL_ONLY";
        snapshot.uploaded_at = null;
        console.warn("[OGame Companion] Supabase-Upload fehlgeschlagen; Spieler-Snapshot wurde nicht gespeichert:", uploadError);
        showCollectorSnackbar(`Supabase-Upload fehlgeschlagen: ${uploadError.message}`, "error");
      }
      updateBackgroundCollectorUi(diagnostics);
      updateCleanCompanionUi();
      // updateCleanCompanionUi setzt den allgemeinen Status neu. Deshalb die
      // konkrete Upload-Antwort anschließend noch einmal sichtbar setzen.
      setCleanSnapshotProgress(3, finalUploadDetail);
      if (progressText) progressText.textContent = `${snapshot.summary.planet_count} Planeten und ${snapshot.summary.moon_count || 0} Monde erfasst`;
      showCollectorSnackbar(`Spieler-Snapshot verarbeitet: ${snapshot.summary.planet_count} Planeten, ${snapshot.summary.moon_count || 0} Monde, ${snapshot.summary.technology_records} Werte.`, "success", [{ label: "Log kopieren", run: copyBackgroundCollectorLog }]);
    } catch (error) {
      const result = { format:"ogame-empire-collector-v1", version:"7.5.0", player_id:metaFromDocument(document,"ogame-player-id"), player_name:metaFromDocument(document,"ogame-player-name"), universe:metaFromDocument(document,"ogame-universe")||location.host, started_at:new Date().toISOString(), finished_at:new Date().toISOString(), status:"ERROR", bodies:[], general_errors:[error.stack||error.message||String(error)] };
      saveBackgroundTest(result); updateBackgroundCollectorUi(result); updateCleanCompanionUi();
      setCleanSnapshotProgress(0, "Empire-Abruf fehlgeschlagen");
      if (progressText) progressText.textContent = "Empire-Abruf fehlgeschlagen";
      showCollectorSnackbar(`Empire-Collector fehlgeschlagen: ${error.message}`, "error", [{ label:"Log kopieren", run:copyBackgroundCollectorLog }]);
    } finally {
      backgroundCollectorRunning = false;
      if (startButton) startButton.disabled = false;
      if (visibleStartButton) visibleStartButton.disabled = false;
    }
  }

  function copyBackgroundCollectorLog() {
    const field = document.querySelector("#oas-bg-log");
    if (!field?.value.trim()) {
      showCollectorSnackbar("Noch kein Collector-Log vorhanden.", "error");
      return;
    }

    try {
      GM_setClipboard(field.value, "text");
    } catch (_) {
      field.focus();
      field.select();
      document.execCommand("copy");
    }
    showCollectorSnackbar("Background-Collector-Log kopiert.", "success");
  }

  function clearBackgroundCollectorTest() {
    localStorage.removeItem(BACKGROUND_TEST_STORAGE_KEY);
    updateBackgroundCollectorUi(null);
    const progress = document.querySelector("#oas-bg-progress");
    if (progress) progress.textContent = "Bereit";
    showCollectorSnackbar("Collector-Testdaten gelöscht.", "info");
  }

  function getPageWindow() {
    return typeof unsafeWindow !== "undefined" && unsafeWindow
      ? unsafeWindow
      : window;
  }


  // Seit 7.5.0 entfernt: der nicht mehr eingebundene Netzwerkmonitor.


  function optimizerTechnologyLevel(list, id) {
    const entry = (list || []).find(item => String(item?.id) === String(id));
    return Number(entry?.level ?? entry?.value ?? entry?.amount ?? 0) || 0;
  }

  function optimizerSolarEnergy(level) {
    const numericLevel = Number(level) || 0;
    return Math.floor(20 * numericLevel * Math.pow(1.1, numericLevel));
  }

  function optimizerPayloadFromSnapshot(snapshot) {
    const planets = (snapshot?.planets || [])
      .filter(planet => planet?.type !== "moon")
      .map(planet => {
        const buildings = planet.buildings || [];
        const lifeformResearch = planet.lifeform_research || [];
        const solarLevel = optimizerTechnologyLevel(buildings, 4);

        return {
          name: planet.name || "Planet",
          coordinates: planet.coordinates || "",
          metalLevel: optimizerTechnologyLevel(buildings, 1),
          crystalLevel: optimizerTechnologyLevel(buildings, 2),
          deutLevel: optimizerTechnologyLevel(buildings, 3),
          solarLevel,
          metalDay: Math.round((Number(planet.production?.metal_per_hour) || 0) * 24),
          crystalDay: Math.round((Number(planet.production?.crystal_per_hour) || 0) * 24),
          deutDay: Math.round((Number(planet.production?.deuterium_per_hour) || 0) * 24),
          solarEnergy: optimizerSolarEnergy(solarLevel),
          energySurplus: Number(planet.production?.energy_available) || 0,
          hpe: optimizerTechnologyLevel(lifeformResearch, 11202),
          magma: optimizerTechnologyLevel(lifeformResearch, 12205),
          geo: optimizerTechnologyLevel(lifeformResearch, 12206),
          seismic: optimizerTechnologyLevel(lifeformResearch, 12211),
          lfAvailable: {
            hpe: optimizerTechnologyLevel(lifeformResearch, 11202) > 0,
            magma: optimizerTechnologyLevel(lifeformResearch, 12205) > 0,
            geo: optimizerTechnologyLevel(lifeformResearch, 12206) > 0,
            seismic: optimizerTechnologyLevel(lifeformResearch, 12211) > 0
          },
          crawler: optimizerTechnologyLevel(planet.ships || [], 217),
          lifeform: planet.lifeform_name || null,
          temperatureMin: Number.isFinite(Number(planet.overview?.temperature_min_c)) ? Number(planet.overview.temperature_min_c) : null,
          temperatureMax: Number.isFinite(Number(planet.overview?.temperature_max_c)) ? Number(planet.overview.temperature_max_c) : null,
          energyProduction: Number.isFinite(Number(planet.production?.energy_production)) ? Number(planet.production.energy_production) : null,
          lifeformBuildings: (planet.lifeform_buildings || []).map(item => ({
            id: String(item.id), name: item.name || `Technologie ${item.id}`, level: Number(item.level ?? item.value ?? 0) || 0
          })),
          lifeformResearch: (planet.lifeform_research || []).map(item => ({
            id: String(item.id), name: item.name || `Technologie ${item.id}`, level: Number(item.level ?? item.value ?? 0) || 0
          }))
        };
      });

    return {
      format: "ogame-optimizer-companion-v1",
      createdAt: snapshot?.created_at || new Date().toISOString(),
      player: snapshot?.player || null,
      universe: snapshot?.universe || location.host,
      plasma: optimizerTechnologyLevel(snapshot?.account?.research || [], 122),
      accountContext: snapshot?.account?.context || null,
      planets
    };
  }

  function optimizerBase64Url(value) {
    const bytes = new TextEncoder().encode(JSON.stringify(value));
    let binary = "";
    for (const byte of bytes) binary += String.fromCharCode(byte);
    return btoa(binary)
      .replace(/\+/g, "-")
      .replace(/\//g, "_")
      .replace(/=+$/g, "");
  }

  function updateOptimizerUi(message = null, kind = "idle") {
    const state = document.querySelector("#oas-optimizer-state");
    const detail = document.querySelector("#oas-optimizer-detail");
    const refreshButton = document.querySelector("#oas-optimizer-refresh");
    const openButton = document.querySelector("#oas-optimizer-open");

    if (state) {
      state.textContent = optimizerSnapshotRunning
        ? "Abruf läuft"
        : optimizerSnapshot
          ? "Aktuell"
          : "Noch nicht aktualisiert";
      state.dataset.kind = optimizerSnapshotRunning
        ? "running"
        : optimizerSnapshot
          ? "success"
          : kind;
    }

    if (detail) {
      detail.textContent = message || (
        optimizerSnapshot
          ? `${optimizerSnapshot.summary?.planet_count || 0} Planeten · Stand ${formatSnapshotDate(optimizerSnapshot.created_at)} · nur im Arbeitsspeicher`
          : "Noch keine Optimizer-Daten ausgelesen. Der Abruf wird nicht gespeichert."
      );
    }

    if (refreshButton) refreshButton.disabled = optimizerSnapshotRunning;
    if (openButton) openButton.disabled = !optimizerSnapshot || optimizerSnapshotRunning;
  }

  async function refreshOptimizerSnapshot() {
    if (optimizerSnapshotRunning || backgroundCollectorRunning) return;

    optimizerSnapshotRunning = true;
    updateOptimizerUi("Imperiumsansicht wird für den Optimizer gelesen …", "running");

    try {
      const { snapshot } = await collectEmpireSnapshot();
      optimizerSnapshot = snapshot;
      updateOptimizerUi(
        `${snapshot.summary?.planet_count || 0} Planeten aktualisiert · Stand ${formatSnapshotDate(snapshot.created_at)} · nicht gespeichert`,
        "success"
      );
      showCollectorSnackbar(
        `Optimizer-Daten aktualisiert: ${snapshot.summary?.planet_count || 0} Planeten. Es wurde kein Spieler-Snapshot gespeichert.`,
        "success"
      );
    } catch (error) {
      console.error("[OGame Companion] Optimizer-Abruf fehlgeschlagen", error);
      optimizerSnapshot = null;
      updateOptimizerUi(`Abruf fehlgeschlagen: ${error.message}`, "error");
      showCollectorSnackbar(`Optimizer-Abruf fehlgeschlagen: ${error.message}`, "error");
    } finally {
      optimizerSnapshotRunning = false;
      updateOptimizerUi();
    }
  }

  function openOptimizer() {
    if (!optimizerSnapshot) {
      showCollectorSnackbar("Bitte zuerst die Optimizer-Daten aktualisieren.", "error");
      return;
    }

    const payload = optimizerPayloadFromSnapshot(optimizerSnapshot);
    const binary = atob(OPTIMIZER_HTML_BASE64);
    const bytes = Uint8Array.from(binary, character => character.charCodeAt(0));
    const optimizerHtml = new TextDecoder().decode(bytes);
    const blobUrl = URL.createObjectURL(
      new Blob([optimizerHtml], { type: "text/html;charset=utf-8" })
    );
    const url = `${blobUrl}#companion=${optimizerBase64Url(payload)}`;
    const opened = window.open(url, "_blank");

    if (!opened) {
      URL.revokeObjectURL(blobUrl);
      showCollectorSnackbar(
        "Der Browser hat das Optimizer-Fenster blockiert. Bitte Pop-ups für OGame erlauben.",
        "error"
      );
      return;
    }

    window.setTimeout(() => URL.revokeObjectURL(blobUrl), 60000);
  }


  function setPlayerSnapshotHeaderState(state = "idle") {
    const button = document.querySelector("#oas-player-snapshot");
    if (!button) return;

    const states = {
      idle: { icon: "↻", title: "Spieler-Snapshot erstellen", disabled: false },
      running: { icon: "⏳", title: "Spieler-Snapshot wird erstellt …", disabled: true },
      success: { icon: "✓", title: "Spieler-Snapshot erfolgreich", disabled: false },
      error: { icon: "!", title: "Spieler-Snapshot fehlgeschlagen", disabled: false }
    };

    const value = states[state] || states.idle;
    button.textContent = value.icon;
    button.title = value.title;
    button.setAttribute("aria-label", value.title);
    button.disabled = value.disabled;
  }

  async function runPlayerSnapshotFromHeader() {
    if (backgroundCollectorRunning) return;

    setPlayerSnapshotHeaderState("running");
    const before = loadBackgroundTest()?.finished_at || null;

    try {
      await runCleanSnapshot();
      const result = loadBackgroundTest();
      const successful =
        result?.finished_at &&
        result.finished_at !== before &&
        result.status !== "ERROR";

      setPlayerSnapshotHeaderState(successful ? "success" : "error");
      updateCleanCompanionUi();
      window.setTimeout(() => setPlayerSnapshotHeaderState("idle"), 1800);
    } catch (error) {
      console.error("[OGame Companion] Spieler-Snapshot fehlgeschlagen", error);
      setPlayerSnapshotHeaderState("error");
      window.setTimeout(() => setPlayerSnapshotHeaderState("idle"), 2500);
    }
  }

  function openDashboard() {
    if (typeof GM_openInTab === "function") {
      GM_openInTab(DASHBOARD_URL, { active: true, insert: true });
    } else {
      window.open(DASHBOARD_URL, "_blank", "noopener");
    }
  }

  function resetData() {
    if (!confirm("Gespeicherte Schiffsangaben für beide Spieler löschen?")) return;
    localStorage.removeItem(STORAGE_KEY);
    updatePanel();
    showMessage("Gespeicherte Daten gelöscht.", "info");
  }

  function statusHtml(name, state) {
    const entry = state[normalize(name)];
    if (!entry) {
      return `<div class="oas-status missing"><strong>${name}</strong><span>noch nicht erfasst</span></div>`;
    }

    return `
      <div class="oas-status found">
        <strong>${entry.player_name}</strong>
        <span>${entry.ships.toLocaleString("de-DE")} Schiffe</span>
      </div>
    `;
  }

  function updatePanel() {
    updateCleanCompanionUi();
  }


  function showMessage(text, kind) {
    const node = document.querySelector("#oas-message");
    if (!node) return;
    node.textContent = text;
    node.dataset.kind = kind;
  }


  function isCollapsed() {
    return localStorage.getItem(PANEL_STATE_KEY) === "true";
  }

  function setCollapsed(collapsed) {
    localStorage.setItem(PANEL_STATE_KEY, String(collapsed));
    applyCollapsedState();
  }

  function loadPanelDetailsState() {
    try {
      const parsed = JSON.parse(localStorage.getItem(PANEL_DETAILS_STATE_KEY) || "{}");
      return parsed && typeof parsed === "object" ? parsed : {};
    } catch (_) {
      return {};
    }
  }

  function panelDetailsKey(details, index) {
    const summary = details?.querySelector(":scope > summary")?.textContent || `bereich-${index}`;
    return String(summary)
      .trim()
      .toLocaleLowerCase("de-DE")
      .replace(/[^a-z0-9äöüß]+/g, "-")
      .replace(/^-+|-+$/g, "") || `bereich-${index}`;
  }

  function initPanelDetailsState(panel) {
    const state = loadPanelDetailsState();
    const allDetails = Array.from(panel.querySelectorAll("details.oas-collapsible"));
    const topLevelDetails = allDetails.filter(details =>
      !details.parentElement?.closest("details.oas-collapsible")
    );

    allDetails.forEach((details, index) => {
      const key = panelDetailsKey(details, index);
      details.dataset.stateKey = key;
      if (Object.prototype.hasOwnProperty.call(state, key)) {
        details.open = Boolean(state[key]);
      }

      details.addEventListener("toggle", () => {
        // Nur die Hauptbereiche verhalten sich wie ein Accordion.
        // Verschachtelte Bereiche wie Diagnose bleiben innerhalb ihres Hauptbereichs unabhängig.
        if (details.open && topLevelDetails.includes(details)) {
          for (const sibling of topLevelDetails) {
            if (sibling !== details && sibling.open) sibling.open = false;
          }
        }

        const next = loadPanelDetailsState();
        for (const item of allDetails) {
          const itemKey = item.dataset.stateKey;
          if (itemKey) next[itemKey] = item.open;
        }
        localStorage.setItem(PANEL_DETAILS_STATE_KEY, JSON.stringify(next));
      });
    });

    // Falls aus dem alten Speicherstand mehrere Hauptbereiche offen sind,
    // bleibt nur der erste offen.
    const opened = topLevelDetails.filter(details => details.open);
    opened.slice(1).forEach(details => { details.open = false; });
  }

  function applyCollapsedState() {
    const panel = document.querySelector("#oas-panel");
    if (!panel) return;

    const collapsed = isCollapsed();
    panel.classList.toggle("oas-collapsed", collapsed);

    const toggle = panel.querySelector("#oas-toggle");
    if (toggle) {
      toggle.textContent = collapsed ? "🚀" : "−";
      toggle.title = collapsed
        ? "Companion öffnen"
        : "Companion minimieren";
      toggle.setAttribute("aria-label", toggle.title);
    }
  }


  function formatSnapshotDate(value) {
    if (!value) return "Noch keiner";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value);
    return date.toLocaleString("de-DE", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit"
    });
  }




  function updateCleanCompanionUi() {
    const result = loadBackgroundTest();

    const playerName =
      metaFromDocument(document, "ogame-player-name") ||
      result?.player_name ||
      "Unbekannt";
    const playerId =
      metaFromDocument(document, "ogame-player-id") ||
      result?.player_id ||
      "–";
    const universe =
      metaFromDocument(document, "ogame-universe") ||
      result?.universe ||
      location.host;

    const nameNode = document.querySelector("#oas-player-name");
    const idNode = document.querySelector("#oas-player-id");
    const universeNode = document.querySelector("#oas-player-universe");
    const lastNode = document.querySelector("#oas-player-last-snapshot");
    const stateNode = document.querySelector("#oas-player-snapshot-state");
    const logNode = document.querySelector("#oas-diagnostic-log");
    const copyButton = document.querySelector("#oas-diagnostic-copy");

    if (nameNode) nameNode.textContent = playerName;
    if (idNode) idNode.textContent = String(playerId);
    if (universeNode) universeNode.textContent = String(universe);
    if (lastNode) {
      lastNode.textContent = result?.finished_at
        ? formatSnapshotDate(result.finished_at)
        : "Noch keiner";
    }

    if (stateNode) {
      const labels = {
        RUNNING: "läuft",
        COMPLETE: "erfolgreich",
        INCOMPLETE: "unvollständig",
        ERROR: "fehlgeschlagen"
      };
      stateNode.textContent = result
        ? (labels[result.status] || result.status || "Unbekannt")
        : "Bereit";
      stateNode.dataset.kind =
        result?.status === "COMPLETE" ? "success" :
        result?.status === "RUNNING" ? "running" :
        result?.status ? "error" : "idle";
    }

    if (result) updateBackgroundCollectorUi(result);

    const hiddenLog = document.querySelector("#oas-bg-log");
    if (logNode) logNode.value = hiddenLog?.value || "";
    if (copyButton) copyButton.disabled = !logNode?.value?.trim();
  }

  async function runCleanSnapshot() {
    await runBackgroundCollectorTest();
    updateCleanCompanionUi();
  }


  function copyCleanDiagnosticLog() {
    const source = document.querySelector("#oas-bg-log");
    const visible = document.querySelector("#oas-diagnostic-log");
    if (source?.value && visible) visible.value = source.value;
    copyBackgroundCollectorLog();
  }

  const COMBAT_STORAGE_KEY = "ogameCompanionCombatLootV2";
  const COMBAT_SHIP_BY_ID = {
    202:"Kleiner Transporter",203:"Großer Transporter",204:"Leichter Jäger",205:"Schwerer Jäger",
    206:"Kreuzer",207:"Schlachtschiff",208:"Kolonieschiff",209:"Recycler",210:"Spionagesonde",
    211:"Bomber",212:"Solarsatellit",213:"Zerstörer",214:"Todesstern",215:"Schlachtkreuzer",
    218:"Reaper",219:"Pathfinder"
  };

  function combatLoad() {
    try {
      const parsed = JSON.parse(localStorage.getItem(COMBAT_STORAGE_KEY) || '{}');
      // Migration von 7.6.4: Die frühere gemeinsame Liste wird einmalig als Tagescache übernommen.
      if (parsed.reports && !parsed.current_reports && !parsed.daily_reports) {
        return { current_reports: {}, daily_reports: parsed.reports || {} };
      }
      return {
        current_reports: parsed.current_reports || {},
        daily_reports: parsed.daily_reports || {}
      };
    } catch {
      return { current_reports: {}, daily_reports: {} };
    }
  }

  function combatSave(data) {
    data.updated_at = new Date().toISOString();
    localStorage.setItem(COMBAT_STORAGE_KEY, JSON.stringify(data));
  }

  function combatPruneDailyReports(reports) {
    return Object.fromEntries(Object.entries(reports || {}).filter(([, report]) => combatIsToday(report)));
  }

  function combatRawAttribute(node, suffix) {
    if (!node?.attributes) return "";
    const wanted = `dataraw${String(suffix || "").replace(/[^a-z0-9]/gi, "").toLowerCase()}`;
    for (const attribute of Array.from(node.attributes)) {
      const normalized = String(attribute.name || "").replace(/[^a-z0-9]/gi, "").toLowerCase();
      if (normalized === wanted) return attribute.value || "";
    }
    return "";
  }

  function combatJsonAttribute(node, suffix, fallback) {
    const value = combatRawAttribute(node, suffix);
    if (!value) return fallback;
    try { return JSON.parse(value); } catch (error) {
      console.warn(`[OGame Companion] Ungültiges Kampfbericht-JSON (${suffix})`, error, value);
      return fallback;
    }
  }

  function combatTextAttribute(node, suffix) {
    return combatRawAttribute(node, suffix);
  }

  function combatOwnIdentity() {
    return {
      id: String(document.querySelector('meta[name="ogame-player-id"]')?.content || ""),
      name: String(document.querySelector('meta[name="ogame-player-name"]')?.content || "").trim().toLowerCase()
    };
  }

  function combatParseMessageNode(source) {
    const message = typeof source === "string"
      ? new DOMParser().parseFromString(String(source || ""), "text/html").querySelector(".msg[data-msg-id]")
      : source;
    const raw = message?.querySelector?.(".rawMessageData");
    if (!message || !raw) return null;

    const type = Number(combatTextAttribute(raw, "messagetype"));
    if (type !== 25) return null;

    const fleets = combatJsonAttribute(raw, "fleets", []);
    const rounds = combatJsonAttribute(raw, "combatrounds", []);
    const result = combatJsonAttribute(raw, "result", {});
    const own = combatOwnIdentity();
    const ownFleets = fleets.filter(fleet => {
      const playerId = String(fleet?.player?.id ?? "");
      const playerName = String(fleet?.player?.name || "").trim().toLowerCase();
      return (own.id && playerId === own.id) || (own.name && playerName === own.name);
    });
    const role = ownFleets[0]?.side || null;
    const ownFleetIds = new Set(ownFleets.map(fleet => String(fleet?.fleetId ?? "")));

    const loot = {metal:0, crystal:0, deuterium:0};
    if (role === "attacker") {
      for (const resource of result?.loot?.resources || []) {
        if (Object.prototype.hasOwnProperty.call(loot, resource?.resource)) {
          loot[resource.resource] += Number(resource?.amount) || 0;
        }
      }
    }

    const ownLoss = (result?.totalValueOfUnitsLost || [])
      .filter(entry => entry?.side === role)
      .reduce((sum, entry) => sum + (Number(entry?.value) || 0), 0);

    const ships = {};
    const lastRound = Array.isArray(rounds) && rounds.length ? rounds[rounds.length - 1] : null;
    for (const fleet of lastRound?.fleets || []) {
      if (fleet?.side !== role) continue;
      if (ownFleetIds.size && !ownFleetIds.has(String(fleet?.fleetId ?? ""))) continue;
      for (const technology of fleet?.technologies || []) {
        const name = COMBAT_SHIP_BY_ID[Number(technology?.technologyId)];
        const destroyed = Number(technology?.destroyedTotal) || 0;
        if (name && destroyed > 0) ships[name] = (ships[name] || 0) + destroyed;
      }
    }

    const timestamp = Number(combatTextAttribute(raw, "timestamp")) || 0;
    const rawDate = combatTextAttribute(raw, "date");
    const dateObject = timestamp ? new Date(timestamp * 1000) : new Date(rawDate);
    const displayedDate = message.querySelector(".msgDate")?.textContent?.trim() ||
      (Number.isNaN(dateObject.getTime()) ? "" : dateObject.toLocaleString("de-DE"));

    return {
      id: String(message.getAttribute("data-msg-id") || ""),
      hash: combatTextAttribute(raw, "hashcode"),
      timestamp,
      date_iso: Number.isNaN(dateObject.getTime()) ? rawDate : dateObject.toISOString(),
      date: displayedDate,
      coords: combatTextAttribute(raw, "coords"),
      target: combatJsonAttribute(raw, "defenderspaceobject", {})?.name || "",
      role,
      winner: result?.winner || null,
      loot,
      lost_resource_value: ownLoss,
      ships,
      parsed_at: new Date().toISOString()
    };
  }

  function combatIsToday(report) {
    const date = report?.timestamp ? new Date(report.timestamp * 1000) : new Date(report?.date_iso || "");
    if (Number.isNaN(date.getTime())) return false;
    const now = new Date();
    return date.getFullYear() === now.getFullYear() &&
      date.getMonth() === now.getMonth() && date.getDate() === now.getDate();
  }

  function combatAggregateReports(reports) {
    const total={metal:0,crystal:0,deuterium:0,lost:0,ships:{}};
    for(const r of reports){
      total.metal += Number(r.loot?.metal)||0;
      total.crystal += Number(r.loot?.crystal)||0;
      total.deuterium += Number(r.loot?.deuterium)||0;
      total.lost += Number(r.lost_resource_value)||0;
      for(const [name,count] of Object.entries(r.ships||{})) total.ships[name]=(total.ships[name]||0)+(Number(count)||0);
    }
    return total;
  }

  function combatCollectLoadedMessageNodes() {
    return Array.from(document.querySelectorAll(".msg[data-msg-id]"))
      .filter(node => node.querySelector(".rawMessageData"));
  }

  function combatReportDay(report) {
    const date = report?.timestamp
      ? new Date(Number(report.timestamp) * 1000)
      : new Date(report?.date_iso || "");
    return Number.isNaN(date.getTime()) ? localDateKey() : localDateKey(date);
  }

  function combatSupabaseUserId(session) {
    if (session?.user?.id) return String(session.user.id);
    try {
      const token = String(session?.access_token || "");
      const payload = token.split(".")[1].replace(/-/g, "+").replace(/_/g, "/");
      return String(JSON.parse(atob(payload))?.sub || "");
    } catch (_) {
      return "";
    }
  }

  function combatToSupabaseRow(report, playerId, ownerId) {
    return {
      owner_id: ownerId,
      ogame_player_id: String(playerId),
      report_id: String(report.id),
      report_day: combatReportDay(report),
      report_timestamp: Number(report.timestamp) || null,
      report_hash: report.hash || null,
      coords: report.coords || null,
      target: report.target || null,
      role: report.role || null,
      winner: report.winner || null,
      loot_metal: Number(report.loot?.metal) || 0,
      loot_crystal: Number(report.loot?.crystal) || 0,
      loot_deuterium: Number(report.loot?.deuterium) || 0,
      lost_resource_value: Number(report.lost_resource_value) || 0,
      ships: report.ships || {},
      payload: report
    };
  }

  function combatFromSupabaseRow(row) {
    const payload = row?.payload && typeof row.payload === "object" ? { ...row.payload } : {};
    return {
      ...payload,
      id: String(row.report_id || payload.id || ""),
      hash: row.report_hash ?? payload.hash ?? "",
      timestamp: Number(row.report_timestamp ?? payload.timestamp) || 0,
      date_iso: payload.date_iso || (row.report_timestamp ? new Date(Number(row.report_timestamp) * 1000).toISOString() : ""),
      date: payload.date || "",
      coords: row.coords ?? payload.coords ?? "",
      target: row.target ?? payload.target ?? "",
      role: row.role ?? payload.role ?? null,
      winner: row.winner ?? payload.winner ?? null,
      loot: {
        metal: Number(row.loot_metal ?? payload.loot?.metal) || 0,
        crystal: Number(row.loot_crystal ?? payload.loot?.crystal) || 0,
        deuterium: Number(row.loot_deuterium ?? payload.loot?.deuterium) || 0
      },
      lost_resource_value: Number(row.lost_resource_value ?? payload.lost_resource_value) || 0,
      ships: row.ships && typeof row.ships === "object" ? row.ships : (payload.ships || {}),
      parsed_at: payload.parsed_at || row.updated_at || row.created_at || new Date().toISOString()
    };
  }

  async function combatSupabaseSyncToday(localReports) {
    const session = await getValidSupabaseSession();
    const playerId = combatOwnIdentity().id;
    const ownerId = combatSupabaseUserId(session);
    if (!playerId) throw new Error("OGame-Spieler-ID konnte nicht ermittelt werden.");
    if (!ownerId) throw new Error("Supabase-Benutzer-ID konnte nicht ermittelt werden.");

    const todaysLocal = (localReports || []).filter(combatIsToday);
    if (todaysLocal.length) {
      const rows = todaysLocal.map(report => combatToSupabaseRow(report, playerId, ownerId));
      await supabaseRequest(
        "POST",
        `${SUPABASE_URL}/rest/v1/ogame_combat_reports?on_conflict=owner_id%2Cogame_player_id%2Creport_id`,
        rows,
        session.access_token,
        30000,
        { Prefer: "resolution=merge-duplicates,return=minimal" }
      );
    }

    const today = localDateKey();
    const selectUrl =
      `${SUPABASE_URL}/rest/v1/ogame_combat_reports` +
      `?select=*` +
      `&ogame_player_id=eq.${encodeURIComponent(playerId)}` +
      `&report_day=eq.${encodeURIComponent(today)}` +
      `&order=report_timestamp.desc`;

    const result = await supabaseRequest(
      "GET",
      selectUrl,
      null,
      session.access_token,
      30000
    );

    const remoteRows = Array.isArray(result.body) ? result.body : [];
    return remoteRows.map(combatFromSupabaseRow).filter(report => report.id);
  }

  async function combatUpdateReports() {
    const button = document.querySelector("#oas-combat-update");
    const state = document.querySelector("#oas-combat-state");

    if (button) button.disabled = true;
    if (state) state.textContent = "Kampfberichte werden vorbereitet …";

    try {
      const previous = combatLoad();
      let dailyReports = combatPruneDailyReports(previous.daily_reports || {});
      let currentReports = previous.current_reports || {};
      const messageNodes = combatCollectLoadedMessageNodes();
      let parsed = 0;
      let fresh = 0;
      let skipped = 0;
      let errors = 0;

      if (messageNodes.length) {
        const parsedCurrentReports = {};
        for (const messageNode of messageNodes) {
          try {
            const report = combatParseMessageNode(messageNode);
            if (!report?.id) { skipped++; continue; }
            if (!previous.current_reports?.[report.id]) fresh++;
            parsedCurrentReports[report.id] = report;
            if (combatIsToday(report)) dailyReports[report.id] = report;
            parsed++;
          } catch (error) {
            errors++;
            console.warn("[OGame Companion] Kampfbericht nicht lesbar", error, messageNode);
          }
        }
        if (parsed > 0) currentReports = parsedCurrentReports;
      }

      combatSave({ current_reports: currentReports, daily_reports: dailyReports });

      let syncText = "nur lokal";
      const session = loadSupabaseSession();

      if (session?.access_token) {
        if (state) state.textContent = "Heutige Kampfberichte werden mit Supabase synchronisiert …";
        try {
          const remoteToday = await combatSupabaseSyncToday(Object.values(dailyReports));
          const mergedToday = { ...dailyReports };
          for (const report of remoteToday) {
            if (report?.id) mergedToday[report.id] = report;
          }
          dailyReports = combatPruneDailyReports(mergedToday);
          combatSave({ current_reports: currentReports, daily_reports: dailyReports });
          syncText = `Supabase: ${Object.keys(dailyReports).length} heute`;
        } catch (syncError) {
          console.warn("[OGame Companion] Kampfberichte-Supabase-Sync fehlgeschlagen", syncError);
          syncText = `Supabase fehlgeschlagen: ${syncError.message}`;
        }
      } else {
        syncText = "Supabase nicht angemeldet";
      }

      combatRender();
      const localCount = Object.keys(dailyReports).length;
      if (state) state.textContent = `${localCount} Kampfberichte heute - ${syncText}`;

      if (parsed > 0) {
        showMessage(
          `${parsed} aktuell sichtbare Kampfberichte übernommen, ${fresh} neu - ${syncText}` +
          `${skipped ? `, ${skipped} andere Nachrichten ignoriert` : ""}` +
          `${errors ? `, ${errors} fehlerhaft` : ""}.`,
          errors ? "info" : "success"
        );
      } else if (localCount > 0) {
        showMessage(`Keine neuen Kampfberichte geladen. Vorhandener Tagesstand wurde synchronisiert - ${syncText}.`, "success");
      } else if (session?.access_token) {
        showMessage(`Keine lokalen oder geladenen Kampfberichte vorhanden - ${syncText}.`, "info");
      } else {
        showMessage("Keine geladenen Kampfberichte gefunden und Supabase ist nicht angemeldet.", "info");
      }
    } catch (error) {
      console.error("[OGame Companion] Kampfberichte konnten nicht synchronisiert werden", error);
      showMessage(`Kampfbericht-Sync fehlgeschlagen: ${error.message}`, "error");
      if (state) state.textContent = "Synchronisierung fehlgeschlagen";
    } finally {
      if (button) button.disabled = false;
    }
  }

  function combatAggregate() {
    const data = combatLoad();
    const reports = Object.values(data.current_reports || {});
    const todayReports = Object.values(combatPruneDailyReports(data.daily_reports));
    return {
      reports,
      total:combatAggregateReports(reports),
      todayReports,
      today:combatAggregateReports(todayReports)
    };
  }

  function combatReset() {
    if (!confirm("Alle lokal gespeicherten Kampfbericht-Auswertungen löschen?")) return;
    localStorage.removeItem(COMBAT_STORAGE_KEY);
    combatRender();
    showMessage("Lokale Kampfbericht-Auswertung wurde zurückgesetzt.", "success");
  }

  function combatOpenOverlay() {
    let overlay=document.querySelector("#oas-combat-overlay");
    if(!overlay){
      overlay=document.createElement("div"); overlay.id="oas-combat-overlay";
      overlay.innerHTML=`<div class="oas-combat-window"><header><div><h2>Kampfberichte – Loot & Verluste</h2><small>Aktuell sichtbare Berichte sowie der heutige Tageswert von 00:00 bis 24:00 Uhr.</small></div><button id="oas-combat-close">×</button></header><div id="oas-combat-summary"></div><div class="oas-combat-table-wrap"><table><thead><tr><th>Datum</th><th>Ziel</th><th>Rolle</th><th>Loot Metall</th><th>Loot Kristall</th><th>Loot Deuterium</th><th>Verlustwert</th><th>Verlorene Schiffe</th></tr></thead><tbody id="oas-combat-tbody"></tbody></table></div></div>`;
      document.body.appendChild(overlay);
      overlay.querySelector("#oas-combat-close").addEventListener("click",()=>overlay.classList.remove("open"));
      overlay.addEventListener("click",e=>{if(e.target===overlay)overlay.classList.remove("open")});
    }
    combatRender(); overlay.classList.add("open");
  }

  function combatKpiHtml(title, reports, total) {
    const fmt=n=>(Number(n)||0).toLocaleString("de-DE");
    return `<section class="oas-combat-section"><h3>${title}</h3><div class="oas-combat-kpis"><div><span>Berichte</span><strong>${reports.length}</strong></div><div><span>Loot gesamt</span><strong>${fmt(total.metal+total.crystal+total.deuterium)}</strong></div><div><span>Metall</span><strong>${fmt(total.metal)}</strong></div><div><span>Kristall</span><strong>${fmt(total.crystal)}</strong></div><div><span>Deuterium</span><strong>${fmt(total.deuterium)}</strong></div><div><span>Schiffsverluste (Ress)</span><strong>${fmt(total.lost)}</strong></div></div><div class="oas-combat-ships"><strong>Verlorene Schiffe:</strong> ${Object.entries(total.ships).sort((a,b)=>b[1]-a[1]).map(([n,c])=>`${n}: ${fmt(c)}`).join(" · ")||"keine"}</div></section>`;
  }

  function combatRender() {
    const {reports,total,todayReports,today}=combatAggregate();
    const fmt=n=>(Number(n)||0).toLocaleString("de-DE");
    const state=document.querySelector("#oas-combat-state");
    if(state) state.textContent=`Heute ${todayReports.length} · Aktuell ${reports.length} Berichte`;
    const summary=document.querySelector("#oas-combat-summary");
    if(summary) summary.innerHTML = combatKpiHtml("Heute · 00:00–24:00 Uhr", todayReports, today) + combatKpiHtml("Aktuell sichtbare Kampfberichte", reports, total);
    const body=document.querySelector("#oas-combat-tbody"); if(!body)return;
  }


  const TRANSPORT_NOTE_STORAGE_KEY = "ogameCompanionTransportNoteDraftV2";
  let transportRemoteSnapshot = null;
  let transportRemoteLoading = false;

  function transportNoteLoad() {
    try {
      const value = JSON.parse(sessionStorage.getItem(TRANSPORT_NOTE_STORAGE_KEY) || "null");
      if (!value || typeof value !== "object") return { items: [] };
      return { ...value, items: Array.isArray(value.items) ? value.items : [] };
    } catch (_) {
      return { items: [] };
    }
  }

  function transportNoteSave(note) {
    sessionStorage.setItem(TRANSPORT_NOTE_STORAGE_KEY, JSON.stringify(note || { items: [] }));
  }

  function transportNoteClearDraft() {
    sessionStorage.removeItem(TRANSPORT_NOTE_STORAGE_KEY);
  }

  function transportNoteNumber(value, preserveSign = false) {
    if (value === null || value === undefined) return null;
    const match = String(value).replace(/\u00a0/g, " ").match(/[-+]?\d[\d.,]*/);
    if (!match) return null;
    const normalized = match[0]
      .replace(/[.,](?=\d{3}(?:[.,]|\D|$))/g, "")
      .replace(",", ".");
    const parsed = Number(normalized);
    if (!Number.isFinite(parsed)) return null;
    const integer = Math.trunc(parsed);
    return preserveSign ? integer : Math.max(0, integer);
  }

  function transportNoteOwnText(element) {
    return Array.from(element?.childNodes || [])
      .filter(node => node.nodeType === Node.TEXT_NODE)
      .map(node => node.textContent || "")
      .join(" ")
      .replace(/\s+/g, " ")
      .trim();
  }

  function transportNoteMissingList() {
    const resourceBox = document.querySelector("#ago_items_resource");
    if (!resourceBox) return null;
    return Array.from(resourceBox.children).find(child => {
      if (child.tagName !== "UL" || child.classList.contains("ago_items_resource_cargo")) return false;
      const firstRow = child.querySelector(":scope > li:first-child");
      return transportNoteOwnText(firstRow).toLocaleLowerCase("de-DE") === "fehlend";
    }) || null;
  }

  function transportNoteMissingValue(missingList, label) {
    if (!missingList) return null;
    const wanted = String(label).toLocaleLowerCase("de-DE");
    const row = Array.from(missingList.querySelectorAll(":scope > li")).find(item =>
      transportNoteOwnText(item).toLocaleLowerCase("de-DE") === wanted
    );
    const valueNode = row?.querySelector(":scope > .ago_items_resource_value");
    const value = valueNode ? transportNoteNumber(valueNode.textContent, true) : null;
    return value !== null && value < 0 ? Math.abs(value) : 0;
  }

  function transportNoteAgoLargeCargo() {
    const resourceBox = document.querySelector("#ago_items_resource");
    const cargoList = resourceBox?.querySelector(":scope > ul.ago_items_resource_cargo");
    if (!cargoList) return 0;
    const row = Array.from(cargoList.querySelectorAll(":scope > li")).find(item => {
      const text = transportNoteOwnText(item).toLocaleLowerCase("de-DE");
      return text === "großer transporter" || text === "grosser transporter";
    });
    const valueNode = row?.querySelector(":scope > .ago_items_resource_value");
    return valueNode ? (transportNoteNumber(valueNode.textContent, false) ?? 0) : 0;
  }

  function transportNoteCurrentTargetName() {
    const metaName = metaFromDocument(document, "ogame-planet-name");
    if (metaName) return String(metaName).trim();
    const selected = document.querySelector(
      "#planetList .smallplanet.hightlight .planet-name, " +
      "#planetList .smallplanet.highlight .planet-name, " +
      "#planetList .smallplanet.active .planet-name, " +
      "#planetList .smallplanet.current .planet-name"
    );
    return String(selected?.textContent || "").trim() || "Unbekannt";
  }

  function transportNoteTargetObject() {
    const details = document.querySelector("#technologydetails");
    if (!details) return "";
    const name = String(
      details.querySelector(":scope > .content h3, .content > h3")?.textContent ||
      details.querySelector("[data-name]")?.getAttribute("data-name") ||
      ""
    ).replace(/\s+/g, " ").trim();
    if (!name) return "";

    const costsText = String(details.querySelector(".content .costs p")?.textContent || "")
      .replace(/\s+/g, " ").trim();
    const targetLevelMatch =
      costsText.match(/(?:Ausbau|Forschung)\s+auf\s+Stufe\s+(\d+)/i) ||
      costsText.match(/Stufe\s+(\d+)/i);

    let targetLevel = targetLevelMatch ? Number(targetLevelMatch[1]) : null;
    if (!Number.isFinite(targetLevel)) {
      const agoNode = details.querySelector("#ago_items_resource .ago_items_resource_header [ago-data*='Construction']");
      const raw = agoNode?.getAttribute("ago-data") || "";
      if (raw) {
        try {
          const parsed = JSON.parse(raw);
          const value = parsed?.message?.data?.value;
          const candidate = Number(value?.current ?? value?.stop ?? value?.start);
          if (Number.isFinite(candidate) && candidate > 0) targetLevel = candidate;
        } catch (_) {}
      }
    }
    if (Number.isFinite(targetLevel) && targetLevel > 0) return `${name} ${targetLevel}`;

    const quantityNode = details.querySelector("input[name='amount'], input[name='number'], input.amount, input[type='number']");
    const quantity = transportNoteNumber(quantityNode?.value, false);
    if (quantity && quantity > 0) return `${name} × ${transportNoteFormat(quantity)}`;
    return name;
  }

  function transportNoteReadCurrentItem() {
    const missingList = transportNoteMissingList();
    if (!missingList) throw new Error("Die AGO-Liste „Fehlend“ wurde auf der aktuellen Seite nicht gefunden.");

    const gt = transportNoteAgoLargeCargo();
    const item = {
      id: `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
      targetName: transportNoteCurrentTargetName(),
      targetObject: transportNoteTargetObject(),
      metal: transportNoteMissingValue(missingList, "Metall"),
      crystal: transportNoteMissingValue(missingList, "Kristall"),
      deuterium: transportNoteMissingValue(missingList, "Deuterium"),
      largeCargo: gt,
      smallCargo: gt * 5,
      done: false,
      capturedAt: new Date().toISOString()
    };

    if (!item.metal && !item.crystal && !item.deuterium) {
      throw new Error("Für den ausgewählten Ausbau wurden keine negativen AGO-Fehlmengen gefunden.");
    }
    return item;
  }

  function transportNoteAggregate(items) {
    return (items || []).reduce((sum, item) => {
      sum.metal += Number(item.metal) || 0;
      sum.crystal += Number(item.crystal) || 0;
      sum.deuterium += Number(item.deuterium) || 0;
      return sum;
    }, { metal: 0, crystal: 0, deuterium: 0 });
  }

  function transportNoteCargoForTotal(total) {
    // Für Planet-Hopping bleibt die Transporterzahl immer auf dem kompletten Plan.
    // Die Anzahl wird aus der SUMME aller Ressourcen mit den im Transportrechner
    // gespeicherten aktuellen Laderaumwerten berechnet.
    const capacities = transportCapacityLoad();
    const totalResources = (Number(total?.metal) || 0) + (Number(total?.crystal) || 0) + (Number(total?.deuterium) || 0);
    const gtCapacity = Math.max(1, Number(capacities?.gt?.value || capacities?.gt || 25000));
    const ktCapacity = Math.max(1, Number(capacities?.kt?.value || capacities?.kt || 5000));
    return {
      largeCargo: Math.ceil(totalResources / gtCapacity),
      smallCargo: Math.ceil(totalResources / ktCapacity)
    };
  }

  function transportNoteReadCurrentPage() {
    if (transportRemoteSnapshot) {
      showMessage("Es gibt bereits eine gespeicherte Transport-Info. Bitte diese zuerst löschen.", "info");
      return;
    }
    const draft = transportNoteLoad();
    if (draft.items.length) {
      showMessage("Der erste Ausbau ist bereits übernommen. Weitere Ausbauten bitte mit [+] hinzufügen.", "info");
      return;
    }
    draft.items = [transportNoteReadCurrentItem()];
    transportNoteSave(draft);
    transportNoteRender();
    showMessage("Erster Ausbau übernommen. Weitere Ausbauten mit [+] hinzufügen.", "success");
  }

  function transportNoteAddCurrentPage() {
    if (transportRemoteSnapshot) {
      showMessage("Es gibt bereits eine gespeicherte Transport-Info. Bitte diese zuerst löschen.", "info");
      return;
    }
    const draft = transportNoteLoad();
    if (!draft.items.length) {
      showMessage("Bitte zuerst „Fehlende Ressourcen übernehmen“ verwenden.", "info");
      return;
    }
    const item = transportNoteReadCurrentItem();
    draft.items.push(item);
    transportNoteSave(draft);
    transportNoteRender();
    showMessage(`${item.targetName} | ${item.targetObject || "Ausbau"} hinzugefügt.`, "success");
  }

  function transportNoteFormat(value) {
    return Number(value || 0).toLocaleString("de-DE");
  }

  function transportNoteEscape(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function transportNotePlayerId() {
    return String(combatOwnIdentity()?.id || "");
  }

  async function transportNoteLoadRemote() {
    if (transportRemoteLoading || !loadSupabaseSession()?.access_token) return transportRemoteSnapshot;
    transportRemoteLoading = true;
    try {
      const session = await getValidSupabaseSession();
      const playerId = transportNotePlayerId();
      if (!playerId) throw new Error("OGame-Spieler-ID konnte nicht ermittelt werden.");

      const result = await supabaseRequest(
        "GET",
        `${SUPABASE_URL}/rest/v1/ogame_transport_note?select=*&ogame_player_id=eq.${encodeURIComponent(playerId)}&limit=1`,
        null,
        session.access_token
      );
      transportRemoteSnapshot =
        Array.isArray(result.body) && result.body.length ? result.body[0] : null;
      transportNoteRender();
      return transportRemoteSnapshot;
    } finally {
      transportRemoteLoading = false;
    }
  }

  async function transportNoteSaveSnapshot() {
    if (transportRemoteSnapshot) {
      showMessage("Es ist bereits eine Transport-Info gespeichert. Bitte diese zuerst löschen.", "info");
      return;
    }

    const draft = transportNoteLoad();
    if (!draft.items.length) {
      showMessage("Noch keine Ausbauten für die Transport-Notiz übernommen.", "info");
      return;
    }

    const session = await getValidSupabaseSession();
    const playerId = transportNotePlayerId();
    const ownerId = combatSupabaseUserId(session);
    if (!playerId || !ownerId) throw new Error("Benutzer- oder OGame-Spieler-ID fehlt.");

    const total = transportNoteAggregate(draft.items);
    const cargo = transportNoteCargoForTotal(total);

    const row = {
      owner_id: ownerId,
      ogame_player_id: playerId,
      items: draft.items,
      total_metal: total.metal,
      total_crystal: total.crystal,
      total_deuterium: total.deuterium,
      large_cargo: cargo.largeCargo,
      small_cargo: cargo.smallCargo
    };

    const result = await supabaseRequest(
      "POST",
      `${SUPABASE_URL}/rest/v1/ogame_transport_note`,
      row,
      session.access_token,
      30000,
      { Prefer: "return=representation" }
    );

    transportRemoteSnapshot = Array.isArray(result.body) ? result.body[0] : null;
    if (!transportRemoteSnapshot) await transportNoteLoadRemote();

    transportNoteClearDraft();
    transportNoteRender();
    showMessage("Transport-Info in Supabase gespeichert.", "success");
  }

  async function transportNoteToggleItem(itemId, checked) {
    if (!transportRemoteSnapshot) return;

    const session = await getValidSupabaseSession();
    const playerId = transportNotePlayerId();
    const items = (Array.isArray(transportRemoteSnapshot.items) ? transportRemoteSnapshot.items : [])
      .map(item =>
        String(item.id) === String(itemId)
          ? { ...item, done: Boolean(checked) }
          : item
      );

    const result = await supabaseRequest(
      "PATCH",
      `${SUPABASE_URL}/rest/v1/ogame_transport_note?ogame_player_id=eq.${encodeURIComponent(playerId)}`,
      { items, updated_at: new Date().toISOString() },
      session.access_token,
      30000,
      { Prefer: "return=representation" }
    );

    transportRemoteSnapshot =
      Array.isArray(result.body) && result.body.length
        ? result.body[0]
        : { ...transportRemoteSnapshot, items };
    transportNoteRender();
  }

  async function transportNoteDeleteSnapshot() {
    if (!transportRemoteSnapshot) {
      showMessage("Keine gespeicherte Transport-Info vorhanden.", "info");
      return;
    }

    const session = await getValidSupabaseSession();
    const playerId = transportNotePlayerId();

    await supabaseRequest(
      "DELETE",
      `${SUPABASE_URL}/rest/v1/ogame_transport_note?ogame_player_id=eq.${encodeURIComponent(playerId)}`,
      null,
      session.access_token
    );

    transportRemoteSnapshot = null;
    transportNoteClearDraft();
    transportNoteRender();
    showMessage("Gespeicherte Transport-Info gelöscht. Eine neue kann jetzt erstellt werden.", "success");
  }

  function transportNoteClear() {
    if (transportRemoteSnapshot) {
      showMessage("Die gespeicherte Transport-Info bitte mit dem Löschbutton darunter entfernen.", "info");
      return;
    }
    transportNoteClearDraft();
    transportNoteRender();
    showMessage("Transport-Entwurf gelöscht.", "success");
  }

  function transportNoteSavedHtml() {
    const root = document.querySelector("#oas-transport-saved");
    if (!root) return;

    if (!transportRemoteSnapshot) {
      root.innerHTML = `<div class="oas-muted">Keine gespeicherte Transport-Info.</div>`;
      return;
    }

    const items = Array.isArray(transportRemoteSnapshot.items) ? transportRemoteSnapshot.items : [];
    const openItems = items.filter(item => !item.done);
    const open = transportNoteAggregate(openItems);

    const rows = items.map(item => `
      <label class="oas-transport-saved-item ${item.done ? "done" : ""}">
        <input type="checkbox" class="oas-transport-done"
          data-id="${transportNoteEscape(item.id)}" ${item.done ? "checked" : ""}>
        <span>
          <strong>${transportNoteEscape(item.targetName || "Unbekannt")} | ${transportNoteEscape(item.targetObject || "Ausbau")}</strong>
          <small>Met ${transportNoteFormat(item.metal)} · Kris ${transportNoteFormat(item.crystal)} · Deut ${transportNoteFormat(item.deuterium)}</small>
        </span>
      </label>
    `).join("");

    root.innerHTML = `
      <div class="oas-transport-saved-list">
        ${rows || `<div class="oas-muted">Keine Positionen.</div>`}
      </div>

      <div class="oas-transport-open-title">Noch zu schicken</div>
      <div class="oas-transport-grid oas-transport-open-grid">
        <span>Metall</span><strong>${transportNoteFormat(open.metal)}</strong>
        <span>Kristall</span><strong>${transportNoteFormat(open.crystal)}</strong>
        <span>Deuterium</span><strong>${transportNoteFormat(open.deuterium)}</strong>
      </div>

      <div class="oas-transport-saved-cargo">
        <strong>GT ${transportNoteFormat(transportRemoteSnapshot.large_cargo)}</strong>
        <span>|</span>
        <strong>KT ${transportNoteFormat(transportRemoteSnapshot.small_cargo)}</strong>
      </div>

      <button id="oas-transport-delete-snapshot" class="oas-secondary" type="button">
        🗑️ Gespeicherte Info löschen
      </button>
    `;

    root.querySelectorAll(".oas-transport-done").forEach(input => {
      input.addEventListener("change", event => {
        const id = event.currentTarget.dataset.id;
        transportNoteToggleItem(id, event.currentTarget.checked).catch(error => {
          event.currentTarget.checked = !event.currentTarget.checked;
          showMessage(`Status konnte nicht gespeichert werden: ${error.message}`, "error");
        });
      });
    });

    root.querySelector("#oas-transport-delete-snapshot")?.addEventListener("click", () => {
      transportNoteDeleteSnapshot().catch(error =>
        showMessage(`Transport-Info konnte nicht gelöscht werden: ${error.message}`, "error")
      );
    });
  }

  function transportNoteRender() {
    const draft = transportNoteLoad();
    const values = transportNoteAggregate(draft.items);
    const cargo = transportNoteCargoForTotal(values);
    const total = values.metal + values.crystal + values.deuterium;

    const mapping = {
      "#oas-transport-metal": values.metal,
      "#oas-transport-crystal": values.crystal,
      "#oas-transport-deuterium": values.deuterium,
      "#oas-transport-total": total,
      "#oas-transport-gt": cargo.largeCargo,
      "#oas-transport-kt": cargo.smallCargo
    };
    for (const [selector, value] of Object.entries(mapping)) {
      const node = document.querySelector(selector);
      if (node) node.textContent = transportNoteFormat(value);
    }

    const draftList = document.querySelector("#oas-transport-draft-list");
    if (draftList) {
      draftList.innerHTML = draft.items.length
        ? draft.items.map((item, index) => `
            <div class="oas-transport-draft-item">
              <span>${index + 1}. ${transportNoteEscape(item.targetName)} | ${transportNoteEscape(item.targetObject || "Ausbau")}</span>
              <small>Met ${transportNoteFormat(item.metal)} · Kris ${transportNoteFormat(item.crystal)} · Deut ${transportNoteFormat(item.deuterium)}</small>
            </div>
          `).join("")
        : `<div class="oas-muted">Noch keine Ausbauten übernommen.</div>`;
    }

    const locked = Boolean(transportRemoteSnapshot);
    const hasDraft = draft.items.length > 0;

    const read = document.querySelector("#oas-transport-read");
    const add = document.querySelector("#oas-transport-add");
    const save = document.querySelector("#oas-transport-save");

    if (read) read.disabled = locked || hasDraft;
    if (add) add.disabled = locked || !hasDraft;
    if (save) save.disabled = locked || !hasDraft;

    const status = document.querySelector("#oas-transport-status");
    if (status) {
      status.textContent = locked
        ? "Eine gespeicherte Transport-Info ist aktiv. Für eine neue bitte zuerst löschen."
        : hasDraft
          ? `${draft.items.length} Ausbau${draft.items.length === 1 ? "" : "ten"} im Entwurf.`
          : "Bereit für eine neue Transport-Notiz.";
    }

    transportNoteSavedHtml();
  }


  // ---------------------------------------------------------------------------

  // Transportrechner
  const TRANSPORT_CALC_STORAGE_KEY = "ogameCompanionTransportCalcV2";
  const TRANSPORT_CAPACITY_CACHE_KEY = "ogameCompanionTransportCapacityV2";
  const TRANSPORT_SHIPS = {
    kt: { id: 202, label: "Kleiner Transporter", fallback: 5000 },
    gt: { id: 203, label: "Großer Transporter", fallback: 25000 },
    recycler: { id: 209, label: "Recycler", fallback: 20000 }
  };

  function transportCalcLoad() {
    const defaults = { metal: 0, crystal: 0, deuterium: 0, mode: "kt", knownType: "kt", knownCount: 0 };
    try {
      const saved = JSON.parse(localStorage.getItem(TRANSPORT_CALC_STORAGE_KEY) || "null");
      return { ...defaults, ...(saved && typeof saved === "object" ? saved : {}) };
    } catch (_) { return defaults; }
  }

  function transportCapacityLoad() {
    const defaults = {
      kt: { value: TRANSPORT_SHIPS.kt.fallback, source: "gespeicherter Standardwert" },
      gt: { value: TRANSPORT_SHIPS.gt.fallback, source: "gespeicherter Standardwert" },
      recycler: { value: TRANSPORT_SHIPS.recycler.fallback, source: "gespeicherter Standardwert" }
    };
    try {
      const saved = JSON.parse(localStorage.getItem(TRANSPORT_CAPACITY_CACHE_KEY) || "null");
      if (!saved || typeof saved !== "object") return defaults;
      const result = { ...defaults };
      for (const key of Object.keys(TRANSPORT_SHIPS)) {
        const value = Number(saved?.[key]?.value ?? saved?.[key]);
        if (Number.isFinite(value) && value > 0) result[key] = { value: Math.floor(value), source: "gespeicherter aktueller Wert" };
      }
      return result;
    } catch (_) { return defaults; }
  }

  function transportCapacitySave(capacities) {
    const normalized = {};
    for (const key of Object.keys(TRANSPORT_SHIPS)) {
      normalized[key] = {
        value: Math.max(1, Math.floor(Number(capacities?.[key]?.value ?? capacities?.[key]) || TRANSPORT_SHIPS[key].fallback)),
        source: "gespeicherter aktueller Wert"
      };
    }
    localStorage.setItem(TRANSPORT_CAPACITY_CACHE_KEY, JSON.stringify({ ...normalized, updatedAt: new Date().toISOString() }));
    return normalized;
  }

  function transportCalcSave(state) {
    localStorage.setItem(TRANSPORT_CALC_STORAGE_KEY, JSON.stringify(state));
  }

  function transportCalcNumber(value) {
    const normalized = String(value ?? "").replace(/\./g, "").replace(/,/g, ".").replace(/[^\d.]/g, "");
    const number = Number(normalized);
    return Number.isFinite(number) ? Math.max(0, Math.floor(number)) : 0;
  }

  function transportCalcFormat(value) {
    return Number(value || 0).toLocaleString("de-DE");
  }

  function transportCalcFormatInput(input) {
    const cursorAtEnd = input.selectionStart === input.value.length;
    const value = transportCalcNumber(input.value);
    input.value = value ? transportCalcFormat(value) : "";
    if (cursorAtEnd) {
      const end = input.value.length;
      try { input.setSelectionRange(end, end); } catch (_) {}
    }
  }

  function transportCapacityInputValue(overlay, key) {
    const input = overlay.querySelector(`#oas-tc-cap-input-${key}`);
    return Math.max(1, transportCalcNumber(input?.value) || TRANSPORT_SHIPS[key].fallback);
  }

  function transportSetCapacityInputs(overlay, capacities) {
    overlay._oasTransportCapacities = capacities;
    for (const key of Object.keys(TRANSPORT_SHIPS)) {
      const value = Number(capacities?.[key]?.value ?? capacities?.[key] ?? TRANSPORT_SHIPS[key].fallback);
      const input = overlay.querySelector(`#oas-tc-cap-input-${key}`);
      if (input) input.value = transportCalcFormat(value);
    }
    transportRenderCapacityCards(overlay);
    transportCalcRender(overlay);
  }

  function transportRenderCapacityCards(overlay) {
    const editing = Boolean(overlay.querySelector("#oas-tc-cap-edit")?.checked);
    overlay.querySelectorAll(".oas-tc-cap-input").forEach(input => {
      input.readOnly = !editing;
      input.tabIndex = editing ? 5 : -1;
    });
    const actions = overlay.querySelector("#oas-tc-cap-actions");
    if (actions) actions.hidden = !editing;
    const status = overlay.querySelector("#oas-tc-capacity-status");
    if (status) status.textContent = editing
      ? "Testwerte können geändert werden. Dauerhaft werden sie erst mit „Laderaum speichern“ übernommen."
      : "Es werden deine gespeicherten aktuellen Ladewerte verwendet.";
  }

  function transportCapacityReadInputs(overlay) {
    const capacities = {};
    for (const key of Object.keys(TRANSPORT_SHIPS)) {
      capacities[key] = { value: transportCapacityInputValue(overlay, key), source: "temporärer Testwert" };
    }
    overlay._oasTransportCapacities = capacities;
    return capacities;
  }

  function transportCapacityUseSaved(overlay) {
    transportSetCapacityInputs(overlay, transportCapacityLoad());
  }

  function transportCapacitySaveCurrent(overlay) {
    const saved = transportCapacitySave(transportCapacityReadInputs(overlay));
    transportSetCapacityInputs(overlay, saved);
    const edit = overlay.querySelector("#oas-tc-cap-edit");
    if (edit) edit.checked = false;
    transportRenderCapacityCards(overlay);
    showCollectorSnackbar("Aktuelle Ladewerte gespeichert.", "success");
  }


  function transportCalcReset(overlay) {
    ["#oas-tc-metal", "#oas-tc-crystal", "#oas-tc-deut", "#oas-tc-known-count"].forEach(selector => {
      const input = overlay.querySelector(selector);
      if (input) input.value = "";
    });
    const ktMode = overlay.querySelector("input[name='oas-tc-mode'][value='kt']");
    const knownKt = overlay.querySelector("input[name='oas-tc-known'][value='kt']");
    if (ktMode) ktMode.checked = true;
    if (knownKt) knownKt.checked = true;
    transportCalcRender(overlay);
    overlay.querySelector("#oas-tc-metal")?.focus();
  }

  function transportCalcReadState(overlay) {
    return {
      metal: transportCalcNumber(overlay.querySelector("#oas-tc-metal")?.value),
      crystal: transportCalcNumber(overlay.querySelector("#oas-tc-crystal")?.value),
      deuterium: transportCalcNumber(overlay.querySelector("#oas-tc-deut")?.value),
      mode: overlay.querySelector("input[name='oas-tc-mode']:checked")?.value || "gt",
      knownType: overlay.querySelector("input[name='oas-tc-known']:checked")?.value || "kt",
      knownCount: transportCalcNumber(overlay.querySelector("#oas-tc-known-count")?.value)
    };
  }

  function transportCalcRender(overlay) {
    const state = transportCalcReadState(overlay);
    transportCalcSave(state);
    const capacities = overlay.querySelector("#oas-tc-cap-edit")?.checked
      ? transportCapacityReadInputs(overlay)
      : (overlay._oasTransportCapacities || transportCapacityLoad());
    const ktCapacity = Math.max(1, Number(capacities?.kt?.value || capacities?.kt || TRANSPORT_SHIPS.kt.fallback));
    const gtCapacity = Math.max(1, Number(capacities?.gt?.value || capacities?.gt || TRANSPORT_SHIPS.gt.fallback));
    const recyclerCapacity = Math.max(1, Number(capacities?.recycler?.value || capacities?.recycler || TRANSPORT_SHIPS.recycler.fallback));
    const total = state.metal + state.crystal + state.deuterium;
    let kt = 0, gt = 0, recycler = 0, covered = 0;

    if (state.mode === "kt") {
      kt = Math.ceil(total / ktCapacity);
      covered = kt * ktCapacity;
    } else if (state.mode === "gt") {
      gt = Math.ceil(total / gtCapacity);
      covered = gt * gtCapacity;
    } else if (state.mode === "recycler") {
      recycler = Math.ceil(total / recyclerCapacity);
      covered = recycler * recyclerCapacity;
    } else if (state.knownType === "kt") {
      kt = state.knownCount;
      const knownVolume = kt * ktCapacity;
      const remaining = Math.max(0, total - knownVolume);
      gt = Math.ceil(remaining / gtCapacity);
      covered = knownVolume + gt * gtCapacity;
    } else {
      gt = state.knownCount;
      const knownVolume = gt * gtCapacity;
      const remaining = Math.max(0, total - knownVolume);
      kt = Math.ceil(remaining / ktCapacity);
      covered = knownVolume + kt * ktCapacity;
    }

    overlay.querySelector("#oas-tc-total").textContent = transportCalcFormat(total);
    overlay.querySelector("#oas-tc-result-kt").textContent = transportCalcFormat(kt);
    overlay.querySelector("#oas-tc-result-gt").textContent = transportCalcFormat(gt);
    overlay.querySelector("#oas-tc-result-recycler").textContent = transportCalcFormat(recycler);
    overlay.querySelector("#oas-tc-covered").textContent = transportCalcFormat(covered);
    overlay.querySelector("#oas-tc-over").textContent = transportCalcFormat(Math.max(0, covered - total));
    const mixed = overlay.querySelector("#oas-tc-mixed-options");
    if (mixed) mixed.hidden = state.mode !== "both";
  }

  function transportCalcOpen() {
    let overlay = document.querySelector("#oas-transport-calc-overlay");
    if (!overlay) {
      const state = transportCalcLoad();
      const cached = transportCapacityLoad();
      overlay = document.createElement("div");
      overlay.id = "oas-transport-calc-overlay";
      overlay.className = "oas-tc-overlay";
      overlay._oasTransportCapacities = cached;
      overlay.innerHTML = `
        <div class="oas-tc-window">
          <header><div><h2>Transportrechner</h2><small>Rohstoffe eingeben und KT, GT, Recycler oder eine KT/GT-Mischflotte berechnen.</small></div><button id="oas-tc-close">×</button></header>
          <div class="oas-tc-body">
            <section class="oas-tc-card oas-tc-resource-card"><div class="oas-tc-section-head"><h3>Ressourcen</h3><button id="oas-tc-reset" class="oas-tc-reset" type="button" title="Ressourcen und Schiffsauswahl zurücksetzen" aria-label="Ressourcen und Schiffsauswahl zurücksetzen">✕</button></div><div class="oas-tc-resource-fields">
              <label><span>Metall</span><input id="oas-tc-metal" inputmode="numeric" maxlength="15" value="${state.metal ? transportCalcFormat(state.metal) : ""}" tabindex="1"></label>
              <label><span>Kristall</span><input id="oas-tc-crystal" inputmode="numeric" maxlength="15" value="${state.crystal ? transportCalcFormat(state.crystal) : ""}" tabindex="2"></label>
              <label><span>Deuterium</span><input id="oas-tc-deut" inputmode="numeric" maxlength="15" value="${state.deuterium ? transportCalcFormat(state.deuterium) : ""}" tabindex="3"></label>
            </div></section>
            <section class="oas-tc-card"><h3>Schiffsauswahl</h3><div class="oas-tc-options">
              <label><input type="radio" name="oas-tc-mode" value="kt" ${state.mode==='kt'?'checked':''}> nur KT</label>
              <label><input type="radio" name="oas-tc-mode" value="gt" ${state.mode==='gt'?'checked':''}> nur GT</label>
              <label><input type="radio" name="oas-tc-mode" value="recycler" ${state.mode==='recycler'?'checked':''}> nur Recycler</label>
              <label><input type="radio" name="oas-tc-mode" value="both" ${state.mode==='both'?'checked':''}> KT + GT</label>
            </div>
            <div id="oas-tc-mixed-options" class="oas-tc-mixed" ${state.mode==='both'?'':'hidden'}>
              <span>Bereits vorhanden:</span>
              <label><input type="radio" name="oas-tc-known" value="kt" ${state.knownType==='kt'?'checked':''}> KT</label>
              <label><input type="radio" name="oas-tc-known" value="gt" ${state.knownType==='gt'?'checked':''}> GT</label>
              <input id="oas-tc-known-count" inputmode="numeric" maxlength="12" value="${state.knownCount ? transportCalcFormat(state.knownCount) : ""}" tabindex="4">
            </div><small class="oas-tc-note">Recycler sind vorerst nicht Teil der KT/GT-Mischberechnung.</small></section>
            <section class="oas-tc-card oas-tc-capacity-card"><div class="oas-tc-cap-head"><h3>Laderaum je Schiff</h3><label class="oas-tc-edit-toggle"><input id="oas-tc-cap-edit" type="checkbox"> Werte ändern</label></div><div class="oas-tc-capacity-list">
              <label><span>Kleiner Transporter</span><input class="oas-tc-cap-input" id="oas-tc-cap-input-kt" inputmode="numeric" maxlength="12" value="${transportCalcFormat(cached?.kt?.value || cached?.kt || TRANSPORT_SHIPS.kt.fallback)}" readonly></label>
              <label><span>Großer Transporter</span><input class="oas-tc-cap-input" id="oas-tc-cap-input-gt" inputmode="numeric" maxlength="12" value="${transportCalcFormat(cached?.gt?.value || cached?.gt || TRANSPORT_SHIPS.gt.fallback)}" readonly></label>
              <label><span>Recycler</span><input class="oas-tc-cap-input" id="oas-tc-cap-input-recycler" inputmode="numeric" maxlength="12" value="${transportCalcFormat(cached?.recycler?.value || cached?.recycler || TRANSPORT_SHIPS.recycler.fallback)}" readonly></label>
            </div><div id="oas-tc-cap-actions" class="oas-tc-cap-actions" hidden><button id="oas-tc-cap-current" class="oas-tc-secondary" type="button"><span aria-hidden="true">↶</span> Aktuelle Werte</button><button id="oas-tc-cap-save" class="oas-primary" type="button">Laderaum speichern</button></div><small id="oas-tc-capacity-status">Es werden deine gespeicherten aktuellen Ladewerte verwendet.</small></section>
            <section class="oas-tc-result"><h3>Ergebnis</h3>
              <div><span>Rohstoffe gesamt</span><strong id="oas-tc-total">0</strong></div>
              <div><span>Kleine Transporter</span><strong id="oas-tc-result-kt">0</strong></div>
              <div><span>Große Transporter</span><strong id="oas-tc-result-gt">0</strong></div>
              <div><span>Recycler</span><strong id="oas-tc-result-recycler">0</strong></div>
              <div><span>Transportvolumen</span><strong id="oas-tc-covered">0</strong></div>
              <div><span>Freier Restladeraum</span><strong id="oas-tc-over">0</strong></div>
            </section>
          </div>
        </div>`;
      document.body.appendChild(overlay);
      overlay.querySelector("#oas-tc-close").addEventListener("click", () => overlay.remove());
      overlay.addEventListener("click", event => { if (event.target === overlay) overlay.remove(); });
      overlay.querySelectorAll("input[inputmode='numeric']").forEach(input => input.addEventListener("input", () => {
        transportCalcFormatInput(input);
        transportCalcRender(overlay);
      }));
      overlay.querySelectorAll("input[type='radio']").forEach(input => input.addEventListener("change", () => transportCalcRender(overlay)));
      overlay.querySelector("#oas-tc-cap-edit")?.addEventListener("change", () => {
        transportRenderCapacityCards(overlay);
        transportCalcRender(overlay);
      });
      overlay.querySelector("#oas-tc-reset")?.addEventListener("click", () => transportCalcReset(overlay));
      overlay.querySelector("#oas-tc-cap-current")?.addEventListener("click", () => transportCapacityUseSaved(overlay));
      overlay.querySelector("#oas-tc-cap-save")?.addEventListener("click", () => transportCapacitySaveCurrent(overlay));
      transportRenderCapacityCards(overlay);
    }
    transportCalcRender(overlay);
    overlay.querySelector("#oas-tc-metal")?.focus();
  }

  // Ressourcenrechner
  // ---------------------------------------------------------------------------
  const RESOURCE_CALC_STORAGE_KEY = "oas_resource_calculator_v2";

  const RESOURCE_CALC_CATEGORIES = [
    { id: "supply", name: "Versorgung", icon: "⛏️" },
    { id: "facilities", name: "Anlagen", icon: "🏭" },
    { id: "research", name: "Forschung", icon: "🔬" },
    { id: "ships", name: "Schiffswerft", icon: "🚀" },
    { id: "defense", name: "Verteidigung", icon: "🛡️" },
    { id: "lfbuildings", name: "Lebensform-Gebäude", icon: "🧬" },
    { id: "lfresearch", name: "Lebensform-Forschung", icon: "🧪" }
  ];

  const RESOURCE_CALC_ITEMS = [
    // Gebäude: Kosten der jeweiligen Zielstufe = Basis * Faktor^(Stufe-1)
    {id:"metal_mine",cat:"supply",name:"Metallmine",icon:"⛏️",kind:"level",base:[60,15,0],factor:1.5},
    {id:"crystal_mine",cat:"supply",name:"Kristallmine",icon:"💎",kind:"level",base:[48,24,0],factor:1.6},
    {id:"deut_synth",cat:"supply",name:"Deuteriumsynthetisierer",icon:"🧪",kind:"level",base:[225,75,0],factor:1.5},
    {id:"solar_plant",cat:"supply",name:"Solarkraftwerk",icon:"☀️",kind:"level",base:[75,30,0],factor:1.5},
    {id:"fusion_plant",cat:"supply",name:"Fusionskraftwerk",icon:"⚛️",kind:"level",base:[900,360,180],factor:1.8},
    {id:"metal_storage",cat:"supply",name:"Metallspeicher",icon:"📦",kind:"level",base:[1000,0,0],factor:2},
    {id:"crystal_storage",cat:"supply",name:"Kristallspeicher",icon:"📦",kind:"level",base:[1000,500,0],factor:2},
    {id:"deut_tank",cat:"supply",name:"Deuteriumtank",icon:"🛢️",kind:"level",base:[1000,1000,0],factor:2},

    {id:"robotics",cat:"facilities",name:"Roboterfabrik",icon:"🤖",kind:"level",base:[400,120,200],factor:2},
    {id:"shipyard",cat:"facilities",name:"Raumschiffwerft",icon:"🏗️",kind:"level",base:[400,200,100],factor:2},
    {id:"research_lab",cat:"facilities",name:"Forschungslabor",icon:"🔬",kind:"level",base:[200,400,200],factor:2},
    {id:"alliance_depot",cat:"facilities",name:"Allianzdepot",icon:"🤝",kind:"level",base:[20000,40000,0],factor:2},
    {id:"missile_silo",cat:"facilities",name:"Raketensilo",icon:"🚀",kind:"level",base:[20000,20000,1000],factor:2},
    {id:"nanite",cat:"facilities",name:"Nanitenfabrik",icon:"⚙️",kind:"level",base:[1000000,500000,100000],factor:2},
    {id:"terraformer",cat:"facilities",name:"Terraformer",icon:"🌍",kind:"level",base:[0,50000,100000],factor:2},

    {id:"espionage",cat:"research",name:"Spionagetechnik",icon:"🛰️",kind:"level",base:[200,1000,200],factor:2},
    {id:"computer",cat:"research",name:"Computertechnik",icon:"💻",kind:"level",base:[0,400,600],factor:2},
    {id:"weapons",cat:"research",name:"Waffentechnik",icon:"⚔️",kind:"level",base:[800,200,0],factor:2},
    {id:"shielding",cat:"research",name:"Schildtechnik",icon:"🛡️",kind:"level",base:[200,600,0],factor:2},
    {id:"armour",cat:"research",name:"Raumschiffpanzerung",icon:"🔩",kind:"level",base:[1000,0,0],factor:2},
    {id:"energy",cat:"research",name:"Energietechnik",icon:"⚡",kind:"level",base:[0,800,400],factor:2},
    {id:"hyperspace",cat:"research",name:"Hyperraumtechnik",icon:"🌀",kind:"level",base:[0,4000,2000],factor:2},
    {id:"combustion",cat:"research",name:"Verbrennungstriebwerk",icon:"🔥",kind:"level",base:[400,0,600],factor:2},
    {id:"impulse",cat:"research",name:"Impulstriebwerk",icon:"💨",kind:"level",base:[2000,4000,600],factor:2},
    {id:"hyperdrive",cat:"research",name:"Hyperraumantrieb",icon:"✨",kind:"level",base:[10000,20000,6000],factor:2},
    {id:"laser",cat:"research",name:"Lasertechnik",icon:"🔴",kind:"level",base:[200,100,0],factor:2},
    {id:"ion",cat:"research",name:"Ionentechnik",icon:"🔵",kind:"level",base:[1000,300,100],factor:2},
    {id:"plasma",cat:"research",name:"Plasmatechnik",icon:"🟣",kind:"level",base:[2000,4000,1000],factor:2},
    {id:"igrn",cat:"research",name:"Intergalaktisches Forschungsnetzwerk",icon:"🌌",kind:"level",base:[240000,400000,160000],factor:2},
    {id:"astro",cat:"research",name:"Astrophysik",icon:"🔭",kind:"level",base:[4000,8000,4000],factor:1.75},
    {id:"graviton",cat:"research",name:"Gravitonforschung",icon:"🌠",kind:"level",base:[0,0,0],factor:3,note:"Benötigt Energie; keine Rohstoffkosten"},

    // Schiffe: Stückkosten
    {id:"small_cargo",cat:"ships",name:"Kleiner Transporter",icon:"📦",kind:"count",cost:[2000,2000,0]},
    {id:"large_cargo",cat:"ships",name:"Großer Transporter",icon:"🚚",kind:"count",cost:[6000,6000,0]},
